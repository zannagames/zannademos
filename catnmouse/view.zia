// File: zannademos/catnmouse/view.zia
// Purpose: Render gameplay and every campaign screen into a headless-safe target.
// Key invariants:
//   - The full board is visible; rendering never mutates simulation state.
//   - Danger lanes use the same lethal query as the catch rule.
//   - Sprite interpolation is derived from board ticks plus a caller-supplied phase.
//   - The caller-supplied effects level gates overlays only; the artwork never changes.
// Ownership/Lifetime:
//   - View owns its render target and cached sprite bank for the application.
// Links: art.zia, rules.zia, rooms.zia, main.zia
//===----------------------------------------------------------------------===//
module view;
bind Zanna.Graphics;
bind Zanna.Text.Fmt as Fmt;
bind "./art";
bind "./rules";
bind "./rooms";
bind "./profile";

final WIDTH = 1344;
final HEIGHT = 872;
final BX = 32;
final BY = 96;
final FOOT = BY + rules.H * art.SIZE + 24;
final SLIDE = 200;
final MOUSE_SLIDE = 90;
final BLINK = 37;

/// @brief Cadence in ticks rendered as seconds with one decimal.
expose func seconds(ticks: Integer) -> String { return Fmt.Int(ticks / 10) + "." + Fmt.Int(ticks % 10) + "S"; }

class View {
    expose RenderTarget2D target;
    expose Pixels pixels;
    expose art.Art bank;
    expose Integer phase;
    hide Integer lastMx;
    hide Integer lastMy;
    hide Integer fromX;
    hide Integer fromY;
    hide Integer slideMs;
    hide Boolean sliding;
    hide Integer shownScore;
    /// @brief 1-based leaderboard rank of the run just recorded, or 0; set by the caller.
    expose Integer recordRank;
    /// @brief Special-effects level (profile.FX_*); set by the caller, FANCY when unset.
    expose Integer fx;

    expose func init() {
        target = RenderTarget2D.New(WIDTH, HEIGHT);
        pixels = target.Pixels as Pixels;
        bank = new art.Art(); phase = 0;
        lastMx = -1; lastMy = -1; fromX = 0; fromY = 0; slideMs = 0; sliding = false;
        shownScore = -1; recordRank = 0; fx = profile.FX_FANCY;
    }
    /// @brief Advance presentation-only animation (the mouse slide) by dt ms.
    expose func advance(dt: Integer) {
        if sliding { slideMs = slideMs + dt; if slideMs >= MOUSE_SLIDE { sliding = false; } }
    }
    /// @brief Note the mouse cell; a single-step change starts a slide, anything else snaps.
    hide func trackMouse(g: rules.Board) {
        if g.mx != lastMx || g.my != lastMy {
            if rules.abs(g.mx - lastMx) + rules.abs(g.my - lastMy) == 1 {
                fromX = lastMx; fromY = lastMy; slideMs = 0; sliding = true;
            } else { sliding = false; }
            lastMx = g.mx; lastMy = g.my;
        }
    }

    hide func text(x: Integer, y: Integer, s: String, color: Integer) { pixels.DrawText(x, y, s, color); }
    hide func big(x: Integer, y: Integer, s: String, scale: Integer, color: Integer) {
        pixels.DrawTextScaled(x, y, s, scale, color);
    }
    hide func sprite(id: Integer, x: Integer, y: Integer) { target.DrawPixels(x, y, bank.sprites.get(id)); }
    hide func keycap(x: Integer, y: Integer, key: String, label: String) -> Integer {
        var w = pixels.TextWidth(key) + 10;
        pixels.DrawBox(x + 1, y - 4, w, 16, 0x0B1B1E);
        pixels.DrawBox(x, y - 5, w, 16, 0x2E4A4D);
        pixels.DrawLine(x, y - 5, x + w - 1, y - 5, 0x53706A);
        self.text(x + 5, y - 1, key, art.PAPER);
        self.text(x + w + 8, y - 1, label, art.MUTED);
        return x + w + 8 + pixels.TextWidth(label) + 22;
    }
    hide func mouseIcon(x: Integer, y: Integer, color: Integer) {
        pixels.DrawDisc(x - 5, y - 6, 4, color); pixels.DrawDisc(x + 5, y - 6, 4, color);
        pixels.DrawEllipse(x, y + 1, 7, 7, color);
    }
    hide func wedge(x: Integer, y: Integer, color: Integer) {
        pixels.DrawTriangle(x, y + 9, x + 12, y + 2, x + 12, y + 9, color);
        pixels.DrawBox(x, y + 9, 12, 2, color);
    }

    hide func header(g: rules.Board) {
        pixels.DrawBox(0, 0, WIDTH, 92, art.NIGHT);
        pixels.DrawBox(0, 88, WIDTH, 4, art.GOLD);
        pixels.DrawBox(0, 0, WIDTH, 2, 0x2E4A4D);
        self.big(32, 20, "CAT 'N' MOUSE", 3, art.PAPER);
        var score = profile.score(g);
        if g.state != rules.PLAY || shownScore < 0 || shownScore > score || fx < 1 { shownScore = score; }
        else if shownScore < score { shownScore = shownScore + 1 + (score - shownScore) / 6; if shownScore > score { shownScore = score; } }
        self.text(34, 55, profile.difficultyName(g.difficulty) + "  /  SCORE " + Fmt.Int(shownScore), art.GOLD);
        self.text(34, 74, "GLOWING SENTRIES HUNT / ROAMERS DROP CRATES", art.MUTED);
        var number = g.room + 1; if number > 10 { number = 10; }
        pixels.DrawBox(408, 14, 4, 62, 0x2E4A4D);
        self.text(432, 20, "ROOM " + Fmt.Int(number) + " OF 10", art.MUTED);
        self.big(432, 38, rooms.name(number - 1), 2, art.PAPER);
        var contract = "GOAL: 12 CHEESE";
        if g.mustClear { contract = "GOAL: 12 CHEESE + BOX ALL ROAMERS"; }
        if g.exitShown { contract = "EXIT OPEN - FIND THE ARCH"; }
        else if g.collected == 12 {
            contract = "BOX IN " + Fmt.Int(g.liveCats()) + " MORE CATS TO OPEN THE EXIT";
            if g.liveCats() == 1 { contract = "BOX IN THE LAST CAT TO OPEN THE EXIT"; }
            if g.liveCats() == 0 { contract = "THE EXIT IS OPENING"; }
        }
        self.text(432, 68, contract, art.GOLD);
        pixels.DrawBox(736, 14, 4, 62, 0x2E4A4D);
        self.text(760, 20, "CHEESE", art.MUTED);
        self.big(760, 38, Fmt.Int(g.collected) + "/12", 3, art.PAPER);
        for i in 0..12 {
            var color = 0x2E4A4D; if i < g.collected { color = art.GOLD; }
            self.wedge(760 + i * 14, 66, color);
        }
        pixels.DrawBox(916, 14, 4, 62, 0x2E4A4D);
        self.text(940, 20, "LIVES", art.MUTED);
        for i in 0..g.maxLives {
            var color = 0x2E4A4D; if i < g.lives { color = art.PAPER; }
            self.mouseIcon(949 + i * 22, 44, color);
        }
        // Cat roster: one icon per cat; gold bar = searching sentry, red frame = catch, X = boxed.
        for i in 0..g.cats.length() {
            var c = g.cats.get(i);
            var ix = 940 + i * 32; var iy = 58;
            if !c.alive {
                pixels.DrawFrame(ix, iy, 24, 24, 0x2E4A4D);
                pixels.DrawLine(ix + 5, iy + 5, ix + 18, iy + 18, art.RED); pixels.DrawLine(ix + 18, iy + 5, ix + 5, iy + 18, art.RED);
                continue;
            }
            target.DrawPixels(ix, iy, bank.icons.get(c.kind));
            if c.kind == 0 && c.searching { pixels.DrawBox(ix, iy + 25, 24, 3, art.GOLD); }
            if c.hold > 0 { pixels.DrawBox(ix, iy + 25, 24, 3, art.MUTED); }
            if g.state == rules.CAUGHT && g.killer == i { pixels.DrawFrame(ix - 2, iy - 2, 28, 28, art.RED); }
        }
        pixels.DrawBox(1106, 14, 4, 62, 0x2E4A4D);
        if g.bonus >= 0 {
            self.text(1130, 20, "BONUS HOPS IN", art.MUTED);
            self.big(1130, 38, seconds(g.countdown), 2, art.PAPER);
            pixels.DrawBox(1130, 66, 178, 6, 0x2E4A4D);
            var span = g.interval * 10; if span <= 0 { span = 1; }
            pixels.DrawBox(1130, 66, 178 * g.countdown / span, 6, art.GOLD);
            self.wedge(1296, 34, art.GOLD);
        } else {
            self.text(1130, 20, "BONUS", art.MUTED);
            self.big(1130, 38, "TAKEN", 2, art.GOLD);
            self.text(1130, 66, Fmt.Int(g.bonuses) + " THIS HEIST", art.MUTED);
        }
    }

    hide func lanes(g: rules.Board) {
        for i in 0..g.cats.length() {
            if !g.hunting(i) { continue; }
            var c = g.cats.get(i);
            for d in 0..4 {
                var x = c.x + rules.dx(d); var y = c.y + rules.dy(d);
                while g.tile(x, y) == 0 {
                    target.DrawPixels(BX + x * art.SIZE, BY + y * art.SIZE, bank.lane);
                    x = x + rules.dx(d); y = y + rules.dy(d);
                }
            }
        }
    }

    hide func catSprite(g: rules.Board, i: Integer) {
        var c = g.cats.get(i);
        var elapsed = (g.ticks - c.movedTick) * 100 + phase;
        if elapsed > SLIDE { elapsed = SLIDE; } if elapsed < 0 { elapsed = 0; }
        var px = BX + c.px * art.SIZE + (c.x - c.px) * art.SIZE * elapsed / SLIDE;
        var py = BY + c.py * art.SIZE + (c.y - c.py) * art.SIZE * elapsed / SLIDE;
        var walking = elapsed < SLIDE;
        var bob = 0; if walking && (elapsed / 50) % 2 == 0 { bob = -2; }
        if fx >= 2 {
            if c.kind == 0 && c.searching {
                target.DrawPixels(px - 16, py - 16 + (g.ticks % 6) / 3, bank.goldHalo);
            }
            if g.state == rules.CAUGHT && g.killer == i { target.DrawPixels(px - 16, py - 16, bank.redHalo); }
        }
        if c.hold > 0 && (g.ticks / 2) % 2 == 0 { return; }
        var frame = bank.sprites.get(5 + c.kind);
        if walking && (elapsed / 50) % 2 == 1 { frame = bank.walk.get(1 + c.kind); }
        target.DrawPixels(px, py + bob, frame);
        if c.kind == 0 && c.searching {
            pixels.DrawBox(px + 19, py + 34 + bob, 9, 5, art.GOLD); pixels.DrawBox(px + 36, py + 34 + bob, 9, 5, art.GOLD);
        } else if !walking && (g.ticks + 9 + i * 11) % BLINK < 2 && g.state == rules.PLAY {
            pixels.DrawBox(px + 18, py + 33 + bob, 11, 7, art.fur(c.kind)); pixels.DrawBox(px + 35, py + 33 + bob, 11, 7, art.fur(c.kind));
            pixels.DrawLine(px + 19, py + 36 + bob, px + 28, py + 36 + bob, art.INK); pixels.DrawLine(px + 36, py + 36 + bob, px + 45, py + 36 + bob, art.INK);
        }
        if g.cheeseAt(c.x, c.y) >= 0 {
            pixels.DrawBox(px + 48, py + 2, 14, 14, art.INK); self.wedge(px + 49, py + 3, art.GOLD);
        }
        if c.hold > 0 { pixels.DrawFrame(px + 1, py + 1, art.SIZE - 2, art.SIZE - 2, art.PAPER); }
    }

    hide func board(g: rules.Board, showLanes: Boolean) {
        bank.retheme(art.theme(g.room));
        pixels.DrawBox(BX - 8, BY - 8, rules.W * art.SIZE + 16, rules.H * art.SIZE + 16, art.WOOD);
        pixels.DrawFrame(BX - 8, BY - 8, rules.W * art.SIZE + 16, rules.H * art.SIZE + 16, 0x5A4030);
        pixels.DrawFrame(BX - 5, BY - 5, rules.W * art.SIZE + 10, rules.H * art.SIZE + 10, 0x241810);
        for y in 0..rules.H {
            for x in 0..rules.W {
                var px = BX + x * art.SIZE; var py = BY + y * art.SIZE;
                var tile = g.tile(x, y);
                if tile == 1 { self.sprite(1, px, py); continue; }
                target.DrawPixels(px, py, bank.floors.get(((x + y) % 2) + ((x * 3 + y * 5) % 4) * 2));
            }
        }
        if showLanes && g.state == rules.PLAY { self.lanes(g); }
        if g.exitShown {
            var exX = BX + g.ex * art.SIZE; var exY = BY + g.ey * art.SIZE;
            if fx >= 2 { target.DrawPixels(exX - 16, exY - 16 + (g.ticks % 8) / 4, bank.greenHalo); }
            self.sprite(9, exX, exY);
            var since = g.ticks - g.exitTick;
            if fx >= 1 && since < 12 {
                pixels.DrawRing(exX + 32, exY + 32, 8 + since * 9, Color.Rgba(168, 216, 163, 220 - since * 18));
                if since > 2 { pixels.DrawRing(exX + 32, exY + 32, since * 6, Color.Rgba(244, 235, 216, 180 - since * 14)); }
            }
        }
        for y in 1..rules.H - 1 {
            for x in 1..rules.W - 1 {
                var tile = g.tile(x, y);
                if tile >= 2 {
                    var px = BX + x * art.SIZE; var py = BY + y * art.SIZE;
                    if tile == 3 { self.sprite(11, px, py); }
                    else { target.DrawPixels(px, py, bank.crates.get((x * 7 + y * 3) % 3)); }
                    if g.lastDrop == y * rules.W + x && g.ticks - g.lastDropTick < 4 {
                        pixels.DrawFrame(px + 2, py + 2, art.SIZE - 4, art.SIZE - 4, art.PAPER);
                    }
                }
            }
        }
        for i in 0..g.cheese.length() {
            var pos = g.cheese.get(i);
            var bob = 0; if ((g.ticks / 4) + pos) % 2 == 0 { bob = -2; }
            self.sprite(3, BX + (pos % rules.W) * art.SIZE, BY + (pos / rules.W) * art.SIZE + bob);
        }
        if g.bonus >= 0 {
            var bx = BX + (g.bonus % rules.W) * art.SIZE; var by = BY + (g.bonus / rules.W) * art.SIZE;
            target.DrawPixels(bx, by, bank.stars.get(g.ticks % 8));
            if fx >= 2 {
                pixels.DrawRing(bx + 32, by + 34, 24 + (g.ticks % 8) / 2, Color.Rgba(240, 189, 85, 150 - (g.ticks % 8) * 15));
            }
        }
        for i in 0..g.cats.length() { if g.cats.get(i).alive { self.catSprite(g, i); } }
        self.trackMouse(g);
        var mx = BX + g.mx * art.SIZE; var my = BY + g.my * art.SIZE;
        var t = MOUSE_SLIDE; if sliding { t = slideMs; if t > MOUSE_SLIDE { t = MOUSE_SLIDE; } }
        var drawX = BX + fromX * art.SIZE + (g.mx - fromX) * art.SIZE * t / MOUSE_SLIDE;
        var drawY = BY + fromY * art.SIZE + (g.my - fromY) * art.SIZE * t / MOUSE_SLIDE;
        if !sliding { drawX = mx; drawY = my; }
        var stepFrame = sliding && (t / 30) % 2 == 1;
        var mouseFrame = bank.sprites.get(4); if stepFrame { mouseFrame = bank.walk.get(0); }
        if g.facing == 2 { mouseFrame = bank.mouseLeft; if stepFrame { mouseFrame = bank.mouseLeftWalk; } }
        var hop = 0; if sliding && t > 20 && t < 70 { hop = -3; }
        target.DrawPixels(drawX, drawY + hop, mouseFrame);
        if !sliding && g.state == rules.PLAY && (g.ticks + 20) % (BLINK + 6) < 2 {
            pixels.DrawBox(drawX + 22, drawY + 31, 7, 7, 0xE8E8D9); pixels.DrawBox(drawX + 37, drawY + 31, 7, 7, 0xE8E8D9);
            pixels.DrawLine(drawX + 22, drawY + 34, drawX + 28, drawY + 34, art.INK); pixels.DrawLine(drawX + 37, drawY + 34, drawX + 43, drawY + 34, art.INK);
        }
        var ring = art.GREEN;
        if g.state == rules.DEAD || g.state == rules.OVER || g.state == rules.CAUGHT { ring = art.RED; }
        else if (g.ticks / 5) % 2 == 0 { ring = 0x7FB37A; }
        pixels.DrawFrame(mx + 1, my + 1, art.SIZE - 2, art.SIZE - 2, ring);
        if g.state == rules.PLAY && g.grace > 0 {
            var number = g.room + 1; if number > 10 { number = 10; }
            var title = "ROOM " + Fmt.Int(number) + "   " + rooms.name(number - 1);
            var w = 700; var cx = BX + rules.W * art.SIZE / 2;
            // The card sits over the top rows unless the mouse starts there.
            var cy = BY + 4; if g.my <= 1 { cy = BY + rules.H * art.SIZE - 100; }
            pixels.DrawBox(cx - w / 2 + 6, cy + 6, w, 92, art.INK);
            pixels.DrawBox(cx - w / 2, cy, w, 92, art.PAPER);
            pixels.DrawBox(cx - w / 2, cy, w, 5, art.GOLD);
            pixels.DrawTextCenteredScaled(cy + 16, title, art.INK, 2);
            pixels.DrawTextCentered(cy + 46, rooms.hint(g.room), 0x63756C);
            pixels.DrawTextCentered(cy + 66, "GET READY", art.INK);
            pixels.DrawBox(cx - w / 2, cy + 88, w * g.grace / rules.GRACE, 4, art.GOLD);
        }
        if g.state == rules.CAUGHT {
            pixels.DrawBox(BX + 500, BY + 8, 280, 44, art.INK);
            pixels.DrawBox(BX + 496, BY + 4, 280, 44, art.RED);
            self.big(BX + 556, BY + 18, "SPOTTED!", 2, art.PAPER);
        }
    }

    hide func footer(g: rules.Board, showLanes: Boolean, muted: Boolean) {
        pixels.DrawBox(0, FOOT - 24, WIDTH, HEIGHT - FOOT + 24, art.NIGHT);
        pixels.DrawBox(0, FOOT - 24, WIDTH, 3, art.GOLD);
        self.text(33, FOOT, g.message, art.PAPER);
        var laneText = "LANES ON"; if !showLanes { laneText = "LANES OFF"; }
        var soundText = "MUSIC ON"; if muted { soundText = "MUSIC OFF"; }
        var x = self.keycap(1040, FOOT + 4, "L", laneText);
        x = self.keycap(x, FOOT + 4, "M", soundText);
        self.text(1040, FOOT + 27, "TURN " + Fmt.Int(g.turn) + "   TIME " + seconds(g.ticks), art.MUTED);
    }

    /// @brief Device-specific hints without covering any board cell.
    expose func inputHints(pad: Boolean, mode: Integer, g: rules.Board) {
        pixels.DrawBox(32, FOOT + 20, 1000, 26, art.NIGHT);
        var y = FOOT + 30;
        if mode != 0 || (g.state != rules.PLAY && g.state != rules.CAUGHT) {
            var x = self.keycap(33, y, "ENTER", "CONFIRM / CONTINUE");
            if pad { x = self.keycap(33, y, "A", "CONFIRM / CONTINUE"); }
            if pad { x = self.keycap(x, y, "B", "BACK"); } else { x = self.keycap(x, y, "ESC", "BACK"); }
            return;
        }
        var x = 33;
        if pad {
            x = self.keycap(x, y, "D-PAD", "MOVE + PUSH"); x = self.keycap(x, y, "X", "WAIT");
            x = self.keycap(x, y, "START", "PAUSE"); x = self.keycap(x, y, "Y", "LANES");
            x = self.keycap(x, y, "RB", "SURRENDER"); x = self.keycap(x, y, "LB", "RESTART");
        } else {
            x = self.keycap(x, y, "ARROWS / WASD", "MOVE + PUSH"); x = self.keycap(x, y, "SPACE", "WAIT");
            x = self.keycap(x, y, "P", "PAUSE"); x = self.keycap(x, y, "H", "HELP");
            x = self.keycap(x, y, "R", "SURRENDER"); x = self.keycap(x, y, "BKSP", "RESTART");
        }
    }

    hide func panel(title: String, subtitle: String) {
        target.DrawPixels(0, 0, bank.dim);
        pixels.DrawBox(230, 228, 904, 436, 0x0B1B1E);
        pixels.DrawBox(220, 218, 904, 436, art.PAPER);
        pixels.DrawFrame(228, 226, 888, 420, 0xBEBAA2);
        pixels.DrawBox(220, 218, 904, 6, art.GOLD);
        self.big(260, 257, title, 3, art.INK);
        pixels.DrawBox(260, 290, 824, 2, 0xD9CDB0);
        self.text(260, 302, subtitle, 0x63756C);
    }

    hide func mapScreen(g: rules.Board) {
        pixels.DrawBox(32, BY, WIDTH - 64, rules.H * art.SIZE, art.NIGHT);
        for i in 0..40 {
            var x = 48 + (i * 197) % 1240; var y = BY + 12 + (i * 89) % 660;
            pixels.DrawBox(x, y, 2, 2, 0x2E4A4D);
        }
        pixels.DrawDisc(1180, 190, 40, 0xE9E2C8); pixels.DrawDisc(1194, 180, 34, art.NIGHT);
        self.big(72, 160, "THE HOUSE, ONE ROOM AT A TIME", 3, art.PAPER);
        self.text(74, 205, "ROOM SECURED. THE HEIST CONTINUES UPSTAIRS.", art.GOLD);
        for n in 0..10 {
            var col = n % 5; var row = n / 5;
            if row == 1 { col = 4 - col; }
            var x = 74 + col * 240; var y = 257 + row * 170;
            var color = 0x2E4A4D; var ink = art.MUTED;
            if n < g.room { color = 0x4E7A62; ink = art.PAPER; }
            if n == g.room { color = art.GOLD; ink = art.INK; }
            if n < 9 {
                var path = 0x648479;
                if n == 4 { for k in 0..10 { pixels.DrawBox(x + 94, y + 74 + k * 10, 3, 5, path); } }
                else if row == 0 { for k in 0..5 { pixels.DrawBox(x + 194 + k * 10, y + 34, 5, 3, path); } }
                else { for k in 0..5 { pixels.DrawBox(x - 6 - k * 10, y + 34, 5, 3, path); } }
            }
            pixels.DrawBox(x + 4, y + 4, 190, 70, 0x0B1B1E);
            pixels.DrawBox(x, y, 190, 70, color);
            pixels.DrawBox(x, y, 190, 4, 0xF6E3A6); if n != g.room { pixels.DrawBox(x, y, 190, 4, 0x5E8A75); }
            if n > g.room { pixels.DrawBox(x, y, 190, 4, 0x3E5C5F); }
            self.big(x + 15, y + 22, Fmt.Int(n + 1), 3, ink);
            if n < g.room { self.text(x + 66, y + 31, "CLEAR", ink); }
            if n == g.room { self.text(x + 66, y + 31, "NEXT", ink); }
            var mini = 5; if n >= 1 { mini = 6; } if n >= 7 { mini = 7; }
            target.DrawPixels(x + 132, y + 6, bank.sprites.get(mini));
            self.text(x, y + 82, rooms.name(n), art.PAPER);
        }
        var col = g.room % 5; var row = g.room / 5; if row == 1 { col = 4 - col; }
        if g.room < 10 { target.DrawPixels(74 + col * 240 + 64, 257 + row * 170 - 64, bank.sprites.get(4)); }
        self.text(74, 595, rooms.hint(g.room), art.PAPER);
        self.big(74, 658, "ENTER  NEXT ROOM", 2, art.GOLD);
        self.text(980, 665, Fmt.Int(g.lives) + " LIVES REMAIN", art.PAPER);
    }

    /// @brief Gameplay, map, help, confirmation and ending screens; menus.zia owns the front end.
    expose func draw(g: rules.Board, mode: Integer, showLanes: Boolean, muted: Boolean) {
        self.header(g); self.board(g, showLanes); self.footer(g, showLanes, muted);
        if mode == 3 {
            self.panel("THE ART OF STAYING HIDDEN", "Cats roam in real time. You move one square per key press.");
            self.text(260, 335, "ARROWS / WASD   Move one square. Walk into a crate to push it.", art.INK);
            self.text(260, 359, "Cats see along rows and columns. Crates stop their gaze.", art.INK);
            self.text(260, 383, "Amber sentries stay put and only hunt while they GLOW.", art.INK);
            self.text(260, 407, "Blue and violet cats wander and drop a crate every few steps.", art.INK);
            self.text(260, 431, "After the cheese, box EVERY wandering cat on four sides to open the exit.", art.INK);
            self.text(260, 455, "Box one in earlier and it simply finds another way in.", art.INK);
            self.text(260, 479, "The star bonus hops around on a timer. Cheese stays where it spawned.", art.INK);
            self.text(260, 503, "The exit only appears once the room's objective is complete.", art.INK);
            self.text(260, 527, "Deaths cost a life. BACKSPACE restarts the room for a life too.", art.INK);
            self.text(260, 566, "L  lanes     M  music     N  sound effects     P / ESC  pause", 0x63756C);
            self.big(260, 602, "ENTER / H  BACK", 2, art.INK); return;
        }
        if mode == 4 || mode == 5 || mode == 9 {
            var title = "LEAVE THE HEIST?";
            if mode == 4 { title = "LEAVE THIS HIDING SPOT?"; }
            if mode == 9 { title = "RESTART THIS ROOM?"; }
            self.panel(title, "The board is paused. No cats move and the bonus stays put.");
            if mode == 4 {
                self.text(260, 387, "Surrender costs ONE LIFE and returns you to the nearest safe refuge.", art.INK);
                self.text(260, 421, "Crates, cheese and cats stay exactly as they are. There is no undo.", art.INK);
                self.big(260, 524, "ENTER  SURRENDER     ESC  CANCEL", 2, art.INK);
            } else if mode == 9 {
                self.text(260, 387, "Restarting costs ONE LIFE and rebuilds the room with new cheese,", art.INK);
                self.text(260, 411, "bonus and cat positions. Collected cheese in this room is lost.", art.INK);
                self.text(260, 445, "Use it when crates have boxed the cheese in.", 0x63756C);
                self.big(260, 524, "ENTER  RESTART     ESC  CANCEL", 2, art.INK);
            } else {
                self.text(260, 387, "Leaving ends this run. There is no saved checkpoint.", art.INK);
                self.big(260, 524, "ENTER  QUIT     ESC  KEEP PLAYING", 2, art.INK);
            }
            return;
        }
        if g.state == rules.MAP { self.mapScreen(g); }
        if g.state == rules.DEAD {
            self.panel("CAUGHT IN A CLEAR LANE", "You lost a life. The changed room stays exactly as you left it.");
            target.DrawPixels(1000, 330, bank.heroCat);
            self.big(260, 375, Fmt.Int(g.lives) + " LIVES LEFT", 3, art.INK);
            self.text(260, 438, "Look at the position before you return. Cover is your only weapon.", art.INK);
            self.big(260, 543, "ENTER  RETURN TO COVER", 2, art.INK);
            self.text(260, 585, "BACKSPACE  RESTART THE ROOM (COSTS A LIFE)", 0x63756C);
        }
        if g.state == rules.OVER || g.state == rules.WON {
            var title = "THE HOUSE WINS THIS TIME";
            var subtitle = g.message;
            if g.state == rules.WON {
                title = "THE MIDNIGHT FEAST IS YOURS";
                subtitle = "Ten rooms cleared. One very well-fed mouse. Not a single weapon.";
            }
            self.panel(title, subtitle);
            if g.state == rules.WON { target.DrawPixels(940, 340, bank.heroMouse); } else { target.DrawPixels(1000, 330, bank.heroCat); }
            self.big(260, 372, Fmt.Int(profile.score(g)) + " POINTS", 3, art.INK);
            if recordRank > 0 {
                var tag = "NEW RECORD  #" + Fmt.Int(recordRank);
                if recordRank == 1 { tag = "NEW HIGH SCORE!"; }
                var tw = pixels.TextScaledWidth(tag, 2) + 24;
                pixels.DrawBox(1084 - tw, 372, tw, 30, art.GOLD);
                pixels.DrawTextScaled(1084 - tw + 12, 379, tag, 2, art.INK);
            }
            self.text(260, 426, "CATS BOXED IN: " + Fmt.Int(g.captures) + "   BONUSES: " + Fmt.Int(g.bonuses), art.INK);
            self.text(260, 455, "TURNS: " + Fmt.Int(g.totalTurns) + "   LIVES LEFT: " + Fmt.Int(g.lives), art.INK);
            self.big(260, 548, "ENTER  HIGH SCORES     ESC  MAIN MENU", 2, art.INK);
        }
    }
}
