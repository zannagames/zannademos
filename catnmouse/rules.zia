// File: zannademos/catnmouse/rules.zia
// Purpose: Deterministic, window-independent Cat 'n' Mouse simulation.
// Key invariants:
//   - Exposure is resolved after each geometry change, before collecting cheese.
//   - A death preserves room state and ends the current turn immediately.
// Ownership/Lifetime:
//   - Board owns its tile, cat and pickup lists for one campaign.
// Links: DESIGN.md, rooms.zia, rules_probe.zia
//===----------------------------------------------------------------------===//
module rules;

final W = 20;
final H = 11;
final PLAY = 0;
final DEAD = 1;
final MAP = 2;
final OVER = 3;
final WON = 4;

expose func abs(n: Integer) -> Integer { if n < 0 { return 0 - n; } return n; }
expose func dx(d: Integer) -> Integer { if d == 0 { return 1; } if d == 2 { return -1; } return 0; }
expose func dy(d: Integer) -> Integer { if d == 1 { return 1; } if d == 3 { return -1; } return 0; }

class Cat {
    expose Integer x;
    expose Integer y;
    expose Integer kind;
    expose Boolean alive;
    expose func init(px: Integer, py: Integer, catKind: Integer) {
        x = px; y = py; kind = catKind; alive = true;
    }
}

/// @brief All positions and random state are integer values for VM/native parity.
class Board {
    expose List[Integer] tiles;
    expose List[Integer] cheese;
    expose List[Cat] cats;
    expose Integer mx;
    expose Integer my;
    expose Integer ex;
    expose Integer ey;
    expose Integer room;
    expose Integer lives;
    expose Integer difficulty;
    expose Integer maxLives;
    expose Integer collected;
    expose Integer turn;
    expose Integer totalTurns;
    expose Integer captures;
    expose Integer seed;
    expose Integer interval;
    expose Integer countdown;
    expose Integer state;
    expose Integer event;
    expose Boolean mustClear;
    expose String message;

    expose func init() {
        tiles = []; cheese = []; cats = [];
        seed = 173; lives = 5; maxLives = 5; difficulty = 1;
        room = 0; totalTurns = 0; captures = 0;
        self.clearRoom();
    }

    /// @brief Reset room geometry, retaining campaign lives, RNG and statistics.
    expose func clearRoom() {
        tiles.clear(); cheese.clear(); cats.clear();
        for y in 0..H {
            for x in 0..W {
                var value = 0;
                if x == 0 || x == W - 1 || y == 0 || y == H - 1 { value = 1; }
                tiles.add(value);
            }
        }
        mx = 1; my = 1; ex = W - 2; ey = H - 2;
        collected = 0; turn = 0; interval = 10; countdown = interval;
        state = PLAY; event = 0; mustClear = false; message = "Read the lanes. Keep your cover.";
    }

    expose func tile(x: Integer, y: Integer) -> Integer {
        if x < 0 || y < 0 || x >= W || y >= H { return 1; }
        return tiles.get(y * W + x);
    }
    expose func setTile(x: Integer, y: Integer, value: Integer) {
        if x > 0 && y > 0 && x < W - 1 && y < H - 1 { tiles.set(y * W + x, value); }
    }
    expose func addCat(x: Integer, y: Integer, kind: Integer) { cats.add(new Cat(x, y, kind)); }
    expose func catAt(x: Integer, y: Integer) -> Integer {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && c.x == x && c.y == y { return i; }
        }
        return -1;
    }
    expose func cheeseAt(x: Integer, y: Integer) -> Integer {
        for i in 0..cheese.length() { if cheese.get(i) == y * W + x { return i; } }
        return -1;
    }
    expose func liveCats() -> Integer {
        var count = 0;
        for i in 0..cats.length() { if cats.get(i).alive { count = count + 1; } }
        return count;
    }
    expose func exitOpen() -> Boolean { return collected == 12 && (!mustClear || self.liveCats() == 0); }

    /// @brief Difficulty is locked for a run, independently of next-run settings.
    expose func cadence(kind: Integer) -> Integer {
        if kind == 0 { return 0; }
        if kind == 1 { if difficulty == 0 { return 3; } return 2; }
        if difficulty == 0 { return 2; }
        return 1;
    }
    expose func nextMove(kind: Integer) -> Integer {
        var period = self.cadence(kind);
        if period == 0 { return 0; }
        return period - turn % period;
    }

    /// @brief Cast from each cat; only solid geometry occludes sightlines.
    expose func danger(x: Integer, y: Integer) -> Boolean {
        if self.tile(x, y) != 0 { return false; }
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && (c.x == x || c.y == y) {
                var sx = 0; var sy = 0;
                if x > c.x { sx = 1; } if x < c.x { sx = -1; }
                if y > c.y { sy = 1; } if y < c.y { sy = -1; }
                var tx = c.x; var ty = c.y; var blocked = false;
                while tx != x || ty != y {
                    tx = tx + sx; ty = ty + sy;
                    if self.tile(tx, ty) != 0 { blocked = true; break; }
                }
                if !blocked { return true; }
            }
        }
        return false;
    }

    expose func capture() {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && c.kind != 0 {
                var closed = 0; var crates = 0;
                for d in 0..4 {
                    var v = self.tile(c.x + dx(d), c.y + dy(d));
                    if v != 0 { closed = closed + 1; }
                    if v == 2 { crates = crates + 1; }
                }
                if closed == 4 && crates > 0 {
                    c.alive = false; captures = captures + 1; event = 3;
                    message = "Boxed in! One fewer cat.";
                }
            }
        }
    }

    expose func lose() {
        if state != PLAY { return; }
        lives = lives - 1; event = 4; state = DEAD;
        message = "Caught in a clear lane!";
        if lives <= 0 { state = OVER; message = "Out of lives."; }
    }
    hide func checkExposure() -> Boolean {
        if self.danger(mx, my) { self.lose(); return true; }
        return false;
    }
    hide func collect() {
        var index = self.cheeseAt(mx, my);
        if index >= 0 {
            cheese.removeAt(index); collected = collected + 1;
            if event < 3 { event = 2; }
            message = "Cheese secured. It stays collected.";
        }
    }

    /// @brief Resume without resetting a single crate, enemy or timer.
    expose func resume() {
        if state != DEAD { return; }
        var best = -1; var distance = W + H;
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !self.danger(x, y) {
                    var dist = x + y;
                    if dist < distance { best = y * W + x; distance = dist; }
                }
            }
        }
        if best < 0 { state = OVER; message = "No safe refuge remains."; return; }
        mx = best % W; my = best / W; state = PLAY; event = 0;
        message = "Back in cover. The room remembers.";
        self.collect();
    }

    hide func random(bound: Integer) -> Integer {
        seed = seed % 2147483647;
        if seed <= 0 { seed = 1 - seed; }
        seed = (seed * 48271) % 2147483647;
        return seed % bound;
    }

    /// @brief Partial Fisher-Yates: bounded sampling without duplicate pickups.
    expose func relocate() {
        cheese.clear();
        var eligible: List[Integer] = [];
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                if self.tile(x, y) == 0 && self.catAt(x, y) < 0 &&
                   !(x == mx && y == my) && !(x == ex && y == ey) {
                    eligible.add(y * W + x);
                }
            }
        }
        var left = 12 - collected;
        while left > 0 && eligible.length() > 0 {
            var index = self.random(eligible.length());
            cheese.add(eligible.get(index));
            eligible.set(index, eligible.get(eligible.length() - 1));
            eligible.removeAt(eligible.length() - 1);
            left = left - 1;
        }
        countdown = interval;
    }

    hide func moveCats() {
        for i in 0..cats.length() {
            var c = cats.get(i);
            var period = self.cadence(c.kind);
            var due = period > 0 && turn % period == 0;
            if c.alive && due {
                var best = -1; var distance = W + H;
                for k in 0..4 {
                    var d = (k + turn + i) % 4;
                    var x = c.x + dx(d); var y = c.y + dy(d);
                    if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !(x == mx && y == my) {
                        var dist = abs(x - mx) + abs(y - my);
                        if dist < distance { distance = dist; best = d; }
                    }
                }
                if best >= 0 { c.x = c.x + dx(best); c.y = c.y + dy(best); }
                if self.checkExposure() { return; }
            }
        }
    }

    /// @brief Resolve one whole turn, stopping at the first lethal transition.
    expose func step(sx: Integer, sy: Integer) -> Boolean {
        event = 0;
        if state != PLAY || abs(sx) + abs(sy) > 1 { return false; }
        var x = mx + sx; var y = my + sy;
        var v = self.tile(x, y);
        if v == 1 || self.catAt(x, y) >= 0 { message = "Blocked. No turn spent."; return false; }
        if v == 2 {
            var bx = x + sx; var by = y + sy;
            if self.tile(bx, by) != 0 || self.catAt(bx, by) >= 0 ||
               self.cheeseAt(bx, by) >= 0 || (bx == ex && by == ey) {
                message = "Blocked. No turn spent."; return false;
            }
            self.setTile(x, y, 0); self.setTile(bx, by, 2); event = 1;
        }
        mx = x; my = y; turn = turn + 1; totalTurns = totalTurns + 1;
        message = "Read the lanes. Keep your cover.";
        self.capture();
        if self.checkExposure() { return true; }
        self.moveCats();
        if state != PLAY { return true; }
        self.collect();
        countdown = countdown - 1;
        if countdown <= 0 {
            self.relocate();
            if collected < 12 { message = "The cheese has scattered again!"; }
        }
        if self.exitOpen() {
            message = "The exit is open. Head for the green arch.";
            if mx == ex && my == ey {
                event = 5; room = room + 1; state = MAP;
                if room >= 10 { state = WON; }
            }
        }
        return true;
    }
}
