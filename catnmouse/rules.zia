// File: zannademos/catnmouse/rules.zia
// Purpose: Deterministic, window-independent real-time Cat 'n' Mouse simulation.
// Key invariants:
//   - Time advances in fixed 100 ms ticks; the mouse moves only on step().
//   - Exposure is resolved after every geometry change and after every cat move.
//   - The exit exists only once all cheese is collected and no roaming cat survives.
//   - A catch walk (CAUGHT) always ends in DEAD or OVER and restores the killer.
//   - Crates never exceed MAX_CRATES, and a cat drop never cuts the mouse off from
//     any remaining cheese, the bonus or the shown exit.
// Ownership/Lifetime:
//   - Board owns its tile, cat and pickup lists for one campaign.
// Links: DESIGN.md, rooms.zia, rules_probe.zia, generator_probe.zia
//===----------------------------------------------------------------------===//
module rules;

final W = 20;
final H = 11;
final PLAY = 0;
final DEAD = 1;
final MAP = 2;
final OVER = 3;
final WON = 4;
final CAUGHT = 5;
final GRACE = 15;
final CHASE = 3;
final BONUS_POINTS = 300;
final DROP_MIN = 14;
final DROP_SPAN = 11;
final MAX_CRATES = 40;

expose func abs(n: Integer) -> Integer { if n < 0 { return 0 - n; } return n; }
expose func dx(d: Integer) -> Integer { if d == 0 { return 1; } if d == 2 { return -1; } return 0; }
expose func dy(d: Integer) -> Integer { if d == 1 { return 1; } if d == 3 { return -1; } return 0; }

/// @brief One cat. Sentries (kind 0) never move; stalkers (1) and prowlers (2) roam.
class Cat {
    expose Integer x;
    expose Integer y;
    expose Integer kind;
    expose Boolean alive;
    expose Integer px;
    expose Integer py;
    expose Integer movedTick;
    expose Integer nextMove;
    expose Integer movesLeft;
    expose Integer hold;
    expose Boolean searching;
    expose Integer searchTimer;
    expose Integer stuck;
    expose Integer homeX;
    expose Integer homeY;
    expose Integer heading;
    expose func init(sx: Integer, sy: Integer, catKind: Integer) {
        x = sx; y = sy; kind = catKind; alive = true;
        px = sx; py = sy; movedTick = -100; nextMove = 0; movesLeft = 18; hold = 0;
        searching = false; searchTimer = 20; stuck = 0; homeX = sx; homeY = sy; heading = -1;
    }
}

/// @brief All positions and random state are integer values for VM/native parity.
class Board {
    expose List[Integer] tiles;
    expose List[Integer] cheese;
    expose List[Cat] cats;
    expose Integer mx;
    expose Integer my;
    expose Integer ex;
    expose Integer ey;
    expose Boolean exitShown;
    expose Integer room;
    expose Integer lives;
    expose Integer difficulty;
    expose Integer maxLives;
    expose Integer collected;
    expose Integer turn;
    expose Integer totalTurns;
    expose Integer captures;
    expose Integer bonuses;
    expose Integer bonus;
    expose Integer seed;
    expose Integer interval;
    expose Integer countdown;
    expose Integer ticks;
    expose Integer grace;
    expose Integer killer;
    expose Integer chaseTimer;
    expose Integer facing;
    expose Integer lastDrop;
    expose Integer lastDropTick;
    expose Integer state;
    expose Integer event;
    expose Boolean mustClear;
    expose String message;
    /// @brief Board cell of the latest capture, drop, hop or reveal, for effects.
    expose Integer eventX;
    expose Integer eventY;
    expose Integer exitTick;

    expose func init() {
        tiles = []; cheese = []; cats = [];
        seed = 173; lives = 5; maxLives = 5; difficulty = 1;
        room = 0; totalTurns = 0; captures = 0; bonuses = 0;
        self.clearRoom();
    }

    /// @brief Reset room geometry, retaining campaign lives, RNG and statistics.
    expose func clearRoom() {
        tiles.clear(); cheese.clear(); cats.clear();
        for y in 0..H {
            for x in 0..W {
                var value = 0;
                if x == 0 || x == W - 1 || y == 0 || y == H - 1 { value = 1; }
                tiles.add(value);
            }
        }
        mx = 1; my = 1; ex = -1; ey = -1; exitShown = false;
        collected = 0; turn = 0; interval = 10; countdown = interval * 10;
        ticks = 0; grace = GRACE; killer = -1; chaseTimer = 0; facing = 0;
        bonus = -1; lastDrop = -1; lastDropTick = -100;
        state = PLAY; event = 0; mustClear = false; message = "Read the lanes. Keep your cover.";
        eventX = -1; eventY = -1; exitTick = -100;
    }

    expose func tile(x: Integer, y: Integer) -> Integer {
        if x < 0 || y < 0 || x >= W || y >= H { return 1; }
        return tiles.get(y * W + x);
    }
    expose func setTile(x: Integer, y: Integer, value: Integer) {
        if x > 0 && y > 0 && x < W - 1 && y < H - 1 { tiles.set(y * W + x, value); }
    }
    /// @brief Every crate on the board, authored or dropped.
    expose func crateCount() -> Integer {
        var count = 0;
        for i in 0..tiles.length() { if tiles.get(i) >= 2 { count = count + 1; } }
        return count;
    }
    expose func addCat(x: Integer, y: Integer, kind: Integer) {
        var c = new Cat(x, y, kind); c.nextMove = self.cadence(kind);
        c.movesLeft = DROP_MIN + self.random(DROP_SPAN);
        cats.add(c);
    }
    expose func catAt(x: Integer, y: Integer) -> Integer {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && c.x == x && c.y == y { return i; }
        }
        return -1;
    }
    expose func cheeseAt(x: Integer, y: Integer) -> Integer {
        for i in 0..cheese.length() { if cheese.get(i) == y * W + x { return i; } }
        return -1;
    }
    expose func bonusAt(x: Integer, y: Integer) -> Boolean { return bonus >= 0 && bonus == y * W + x; }
    expose func isExit(x: Integer, y: Integer) -> Boolean { return exitShown && x == ex && y == ey; }
    /// @brief Cells that pickups, drops and the exit must never cover.
    expose func reserved(x: Integer, y: Integer) -> Boolean {
        return (x == mx && y == my) || self.cheeseAt(x, y) >= 0 || self.bonusAt(x, y) || self.isExit(x, y);
    }
    /// @brief Only roaming cats count toward the clear-all objective (sentries are permanent).
    expose func liveCats() -> Integer {
        var count = 0;
        for i in 0..cats.length() { var c = cats.get(i); if c.alive && c.kind != 0 { count = count + 1; } }
        return count;
    }
    /// @brief Every room requires all twelve cheese and every roaming cat boxed in; sentries never count.
    expose func exitOpen() -> Boolean { return collected == 12 && self.liveCats() == 0; }

    /// @brief Ticks between roaming moves; difficulty is locked for a run.
    expose func cadence(kind: Integer) -> Integer {
        if kind == 0 { return 0; }
        if kind == 1 { if difficulty == 0 { return 11; } if difficulty == 2 { return 8; } return 9; }
        if difficulty == 0 { return 8; } if difficulty == 2 { return 4; }
        return 5;
    }

    /// @brief True when no solid tile lies strictly between two cells sharing a row or column.
    expose func clear(x0: Integer, y0: Integer, x1: Integer, y1: Integer) -> Boolean {
        if x0 != x1 && y0 != y1 { return false; }
        if self.tile(x1, y1) != 0 { return false; }
        var sx = 0; var sy = 0;
        if x1 > x0 { sx = 1; } if x1 < x0 { sx = -1; }
        if y1 > y0 { sy = 1; } if y1 < y0 { sy = -1; }
        var tx = x0; var ty = y0;
        while tx != x1 || ty != y1 {
            tx = tx + sx; ty = ty + sy;
            if self.tile(tx, ty) != 0 { return false; }
        }
        return true;
    }
    /// @brief Whether a cat is currently able to kill along its lanes.
    expose func hunting(i: Integer) -> Boolean {
        var c = cats.get(i);
        if !c.alive || c.hold > 0 || grace > 0 { return false; }
        if c.kind == 0 && !c.searching { return false; }
        return true;
    }
    /// @brief Raw geometry: any living cat has a clear row/column to the cell.
    expose func exposed(x: Integer, y: Integer) -> Boolean {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && self.clear(c.x, c.y, x, y) { return true; }
        }
        return false;
    }
    /// @brief Index of a hunting cat that sees the cell, or -1.
    expose func threat(x: Integer, y: Integer) -> Integer {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if self.hunting(i) && self.clear(c.x, c.y, x, y) { return i; }
        }
        return -1;
    }
    expose func lethal(x: Integer, y: Integer) -> Boolean { return self.threat(x, y) >= 0; }
    /// @brief Kept for callers that only care about geometry (lanes overlay uses lethal).
    expose func danger(x: Integer, y: Integer) -> Boolean { return self.lethal(x, y); }

    expose func random(bound: Integer) -> Integer {
        seed = seed % 2147483647;
        if seed <= 0 { seed = 1 - seed; }
        seed = (seed * 48271) % 2147483647;
        return seed % bound;
    }
    expose func freeNeighbors(x: Integer, y: Integer, skipX: Integer, skipY: Integer) -> Integer {
        var count = 0;
        for d in 0..4 {
            var nx = x + dx(d); var ny = y + dy(d);
            if self.tile(nx, ny) == 0 && !(nx == skipX && ny == skipY) { count = count + 1; }
        }
        return count;
    }

    /// @brief Floor-only breadth-first reach from a cell: one flag per board cell (1 = reachable).
    expose func flood(x0: Integer, y0: Integer) -> List[Integer] {
        var seen: List[Integer] = [];
        while seen.length() < W * H { seen.add(0); }
        if self.tile(x0, y0) != 0 { return seen; }
        var queue: List[Integer] = [y0 * W + x0];
        seen.set(queue.get(0), 1); var head = 0;
        while head < queue.length() {
            var pos = queue.get(head); head = head + 1;
            var x = pos % W; var y = pos / W;
            for d in 0..4 {
                var nx = x + dx(d); var ny = y + dy(d);
                if self.tile(nx, ny) == 0 {
                    var next = ny * W + nx;
                    if seen.get(next) == 0 { seen.set(next, 1); queue.add(next); }
                }
            }
        }
        return seen;
    }
    /// @brief True when every remaining cheese, the bonus and the shown exit are flagged reachable.
    expose func reachesAll(seen: List[Integer]) -> Boolean {
        for i in 0..cheese.length() { if seen.get(cheese.get(i)) == 0 { return false; } }
        if bonus >= 0 && seen.get(bonus) == 0 { return false; }
        if exitShown && seen.get(ey * W + ex) == 0 { return false; }
        return true;
    }
    /// @brief True when every floor cell can be walked to from the mouse without pushing.
    expose func connected() -> Boolean {
        var seen = self.flood(mx, my);
        for i in 0..tiles.length() { if tiles.get(i) == 0 && seen.get(i) == 0 { return false; } }
        return true;
    }
    /// @brief Free, unreserved, cat-free floor cells the mouse can walk to.
    hide func eligible() -> List[Integer] {
        var cells: List[Integer] = [];
        var seen = self.flood(mx, my);
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                if self.tile(x, y) == 0 && seen.get(y * W + x) == 1 && self.catAt(x, y) < 0 && !self.reserved(x, y) {
                    cells.add(y * W + x);
                }
            }
        }
        return cells;
    }

    /// @brief Partial Fisher-Yates: place outstanding cheese once per room without duplicates.
    expose func scatter() {
        cheese.clear();
        var cells = self.eligible();
        var left = 12 - collected;
        while left > 0 && cells.length() > 0 {
            var index = self.random(cells.length());
            cheese.add(cells.get(index));
            cells.set(index, cells.get(cells.length() - 1));
            cells.removeAt(cells.length() - 1);
            left = left - 1;
        }
    }
    /// @brief Compatibility alias used by older probes.
    expose func relocate() { self.scatter(); }

    /// @brief Place (or teleport) the room bonus and restart its countdown.
    expose func placeBonus() {
        if bonus >= 0 { eventX = bonus % W; eventY = bonus / W; }
        bonus = -1;
        var cells = self.eligible();
        if cells.length() > 0 { bonus = cells.get(self.random(cells.length())); }
        countdown = interval * 10;
    }

    /// @brief Choose a floor cell reachable from the mouse for the exit and show it.
    expose func revealExit() {
        var seen = self.flood(mx, my);
        var far: List[Integer] = []; var near: List[Integer] = [];
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                var pos = y * W + x;
                if seen.get(pos) == 1 && self.catAt(x, y) < 0 && !self.reserved(x, y) {
                    if abs(x - mx) + abs(y - my) >= 4 { far.add(pos); } else { near.add(pos); }
                }
            }
        }
        var cells = far; if cells.length() == 0 { cells = near; }
        if cells.length() == 0 { ex = mx; ey = my; }
        else { var pos = cells.get(self.random(cells.length())); ex = pos % W; ey = pos / W; }
        exitShown = true; event = 9; exitTick = ticks; eventX = ex; eventY = ey;
        message = "The exit has appeared. Head for the green arch.";
    }

    /// @brief Move a cat to a random covered cell that cannot see the mouse, with a hold delay.
    /// Returns false (and throttles the retry) when no such cell exists.
    expose func respawn(i: Integer) -> Boolean {
        var c = cats.get(i);
        var cells: List[Integer] = [];
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !self.reserved(x, y) &&
                   !self.clear(x, y, mx, my) && self.freeNeighbors(x, y, -1, -1) >= 2 {
                    cells.add(y * W + x);
                }
            }
        }
        if cells.length() == 0 { c.hold = GRACE; return false; }
        var pos = cells.get(self.random(cells.length()));
        c.x = pos % W; c.y = pos / W; c.px = c.x; c.py = c.y; c.movedTick = ticks;
        c.homeX = c.x; c.homeY = c.y;
        c.hold = GRACE; c.stuck = 0; c.heading = -1; c.nextMove = self.cadence(c.kind);
        c.movesLeft = DROP_MIN + self.random(DROP_SPAN);
        if event < 12 { event = 12; eventX = c.x; eventY = c.y; }
        message = "The cat found another way in.";
        return true;
    }

    /// @brief A roaming cat enclosed on four sides: captured once the cheese is done, otherwise it escapes.
    hide func boxed(i: Integer) {
        var c = cats.get(i);
        if !c.alive || c.kind == 0 { return; }
        for d in 0..4 { if self.tile(c.x + dx(d), c.y + dy(d)) == 0 { return; } }
        if collected == 12 {
            c.alive = false; captures = captures + 1; event = 3; eventX = c.x; eventY = c.y;
            message = "Boxed in! One fewer cat.";
        } else { var _ = self.respawn(i); }
    }
    expose func capture() { for i in 0..cats.length() { self.boxed(i); } }

    /// @brief Drop a crate on a vacated cell unless the cap is reached or it would cut the
    /// mouse off from any remaining cheese, the bonus, the shown exit or every neighbour.
    expose func drop(x: Integer, y: Integer) -> Boolean {
        if self.tile(x, y) != 0 || self.catAt(x, y) >= 0 || self.reserved(x, y) { return false; }
        if self.crateCount() >= MAX_CRATES { return false; }
        self.setTile(x, y, 3);
        var seen = self.flood(mx, my);
        if !self.reachesAll(seen) || self.freeNeighbors(mx, my, -1, -1) == 0 {
            self.setTile(x, y, 0); return false;
        }
        lastDrop = y * W + x; lastDropTick = ticks; eventX = x; eventY = y;
        if event < 11 { event = 11; }
        return true;
    }

    expose func lose() {
        if state != PLAY && state != CAUGHT { return; }
        lives = lives - 1; event = 4; state = DEAD;
        message = "Caught in a clear lane!";
        if lives <= 0 { state = OVER; message = "Out of lives."; }
    }
    hide func checkExposure() -> Boolean {
        if state != PLAY { return false; }
        var k = self.threat(mx, my);
        if k < 0 { return false; }
        var c = cats.get(k);
        killer = k; chaseTimer = CHASE; c.homeX = c.x; c.homeY = c.y;
        state = CAUGHT; event = 10; message = "Spotted! The cat is coming.";
        return true;
    }
    hide func collect() {
        var index = self.cheeseAt(mx, my);
        if index >= 0 {
            cheese.removeAt(index); collected = collected + 1;
            if event < 2 { event = 2; }
            message = "Cheese secured. It stays collected.";
        }
        if self.bonusAt(mx, my) {
            bonus = -1; bonuses = bonuses + 1; event = 8;
            message = "Bonus! Extra points.";
        }
    }

    /// @brief True when a living sentry has a clear lane to the cell (roamers are about to move).
    hide func sentryLane(x: Integer, y: Integer) -> Boolean {
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && c.kind == 0 && self.clear(c.x, c.y, x, y) { return true; }
        }
        return false;
    }

    /// @brief Resume after a death: the mouse and every roaming cat reappear somewhere random.
    /// Crates, cheese, the bonus, sentries and timers are untouched. The refuge is chosen so
    /// every remaining cheese stays reachable whenever such a cell exists.
    expose func resume() {
        if state != DEAD { return; }
        var region: List[Integer] = [];
        if cheese.length() > 0 {
            region = self.flood(cheese.get(0) % W, cheese.get(0) / W);
            if !self.reachesAll(region) { region = []; }
        }
        var cells: List[Integer] = [];
        for y in 1..H - 1 {
            for x in 1..W - 1 {
                if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !self.bonusAt(x, y) &&
                   !self.isExit(x, y) && !self.sentryLane(x, y) && self.freeNeighbors(x, y, -1, -1) > 0 &&
                   (region.length() == 0 || region.get(y * W + x) == 1) {
                    cells.add(y * W + x);
                }
            }
        }
        if cells.length() == 0 {
            for y in 1..H - 1 {
                for x in 1..W - 1 {
                    if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !self.sentryLane(x, y) { cells.add(y * W + x); }
                }
            }
        }
        if cells.length() == 0 { state = OVER; message = "No safe refuge remains."; return; }
        var pos = cells.get(self.random(cells.length()));
        mx = pos % W; my = pos / W;
        for i in 0..cats.length() {
            var c = cats.get(i);
            if c.alive && c.kind != 0 { var _ = self.respawn(i); }
        }
        state = PLAY; event = 0; grace = GRACE;
        message = "New hiding spot. The cats have scattered too.";
        self.collect();
    }

    /// @brief Quick restart: costs a life; the caller reloads the room with fresh randomness.
    expose func restart() -> Boolean {
        if state != PLAY && state != CAUGHT && state != DEAD { return false; }
        lives = lives - 1; event = 4;
        if lives <= 0 { state = OVER; message = "Out of lives."; return false; }
        return true;
    }

    hide func moveCat(i: Integer) {
        var c = cats.get(i);
        var options: List[Integer] = [];
        var reverse = -1; if c.heading >= 0 { reverse = (c.heading + 2) % 4; }
        for d in 0..4 {
            var x = c.x + dx(d); var y = c.y + dy(d);
            if self.tile(x, y) == 0 && self.catAt(x, y) < 0 && !(x == mx && y == my) { options.add(d); }
        }
        if options.length() > 1 {
            for k in 0..options.length() {
                if options.get(k) == reverse { options.removeAt(k); break; }
            }
        }
        c.nextMove = self.cadence(c.kind);
        if options.length() == 0 {
            c.stuck = c.stuck + 1;
            if c.stuck >= 3 { var _ = self.respawn(i); }
            return;
        }
        c.stuck = 0;
        var d = options.get(self.random(options.length()));
        c.px = c.x; c.py = c.y; c.x = c.x + dx(d); c.y = c.y + dy(d);
        c.movedTick = ticks; c.heading = d;
        c.movesLeft = c.movesLeft - 1;
        if c.movesLeft <= 0 {
            var _ = self.drop(c.px, c.py);
            c.movesLeft = DROP_MIN + self.random(DROP_SPAN);
            self.capture();
        }
    }

    /// @brief One catch-walk beat. A cat blocking the lane takes over the walk; a crate ends it.
    hide func chase() {
        var c = cats.get(killer);
        chaseTimer = chaseTimer - 1;
        if chaseTimer > 0 { return; }
        chaseTimer = CHASE;
        var sx = 0; var sy = 0;
        if mx > c.x { sx = 1; } if mx < c.x { sx = -1; }
        if my > c.y { sy = 1; } if my < c.y { sy = -1; }
        var nx = c.x + sx; var ny = c.y + sy;
        if nx == mx && ny == my {
            c.x = c.homeX; c.y = c.homeY; c.px = c.x; c.py = c.y; c.movedTick = -100;
            killer = -1; self.lose(); return;
        }
        var other = self.catAt(nx, ny);
        if other >= 0 {
            c.x = c.homeX; c.y = c.homeY; c.px = c.x; c.py = c.y; c.movedTick = -100;
            var next = cats.get(other);
            next.homeX = next.x; next.homeY = next.y; killer = other; event = 10;
            return;
        }
        if self.tile(nx, ny) != 0 {
            c.x = c.homeX; c.y = c.homeY; c.px = c.x; c.py = c.y; c.movedTick = -100;
            killer = -1; self.lose(); return;
        }
        c.px = c.x; c.py = c.y; c.x = nx; c.y = ny; c.movedTick = ticks; event = 10;
    }

    /// @brief Advance one 100 ms tick. Returns true when anything observable changed.
    expose func tick() -> Boolean {
        event = 0;
        if state == CAUGHT { ticks = ticks + 1; self.chase(); return true; }
        if state != PLAY { return false; }
        ticks = ticks + 1;
        if grace > 0 { grace = grace - 1; }
        for i in 0..cats.length() {
            var c = cats.get(i);
            if !c.alive { continue; }
            if c.hold > 0 { c.hold = c.hold - 1; continue; }
            if grace > 0 { continue; }
            if c.kind == 0 {
                c.searchTimer = c.searchTimer - 1;
                if c.searchTimer <= 0 {
                    c.searching = !c.searching;
                    if c.searching { c.searchTimer = 15 + self.random(16); }
                    else { c.searchTimer = 20 + self.random(31); }
                }
            } else {
                self.boxed(i);
                if !c.alive || c.hold > 0 { continue; }
                c.nextMove = c.nextMove - 1;
                if c.nextMove <= 0 { self.moveCat(i); }
            }
            if self.checkExposure() { return true; }
        }
        if bonus >= 0 {
            countdown = countdown - 1;
            if countdown <= 0 { self.placeBonus(); if event < 13 { event = 13; } }
        }
        if self.checkExposure() { return true; }
        if !exitShown && self.exitOpen() { self.revealExit(); }
        return true;
    }

    /// @brief Resolve one player action (move, push or wait), stopping at a lethal transition.
    /// Waiting spends no turn: it only re-evaluates pickups and enclosures.
    expose func step(sx: Integer, sy: Integer) -> Boolean {
        event = 0;
        if state != PLAY || abs(sx) + abs(sy) > 1 { return false; }
        if sx == 1 { facing = 0; } if sx == -1 { facing = 2; }
        if sy == 1 { facing = 1; } if sy == -1 { facing = 3; }
        var x = mx + sx; var y = my + sy;
        var v = self.tile(x, y);
        if v == 1 || self.catAt(x, y) >= 0 { message = "Blocked. No turn spent."; return false; }
        if v >= 2 {
            var bx = x + sx; var by = y + sy;
            if self.tile(bx, by) != 0 || self.catAt(bx, by) >= 0 || self.reserved(bx, by) {
                message = "Blocked. No turn spent."; return false;
            }
            self.setTile(x, y, 0); self.setTile(bx, by, v); event = 1;
        }
        if sx != 0 || sy != 0 { turn = turn + 1; totalTurns = totalTurns + 1; }
        mx = x; my = y;
        message = "Read the lanes. Keep your cover.";
        self.collect();
        self.capture();
        if self.checkExposure() { return true; }
        if !exitShown && self.exitOpen() { self.revealExit(); }
        if self.isExit(mx, my) {
            event = 5; room = room + 1; state = MAP;
            if room >= 10 { state = WON; }
        }
        return true;
    }
}
