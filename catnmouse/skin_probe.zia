//===----------------------------------------------------------------------===//
//
// File: zannademos/catnmouse/skin_probe.zia
// Purpose: Verify PNG override loading, filtering and generated fallback in an
//          isolated directory.
// Key invariants:
//   - Test fixtures are written only in a scratch directory this probe owns, or
//     in an explicitly supplied empty one.
//   - A scratch directory this probe created is always removed again.
// Ownership/Lifetime:
//   - Temporary PNG fixtures belong to the scratch directory in use.
// Links: art.zia, assets/README.md
//
//===----------------------------------------------------------------------===//
module skin_probe;
bind Zanna.Graphics;
bind Zanna.Terminal as Terminal;
bind Zanna.System.Environment as Env;
bind Zanna.System.Machine as Machine;
bind Zanna.IO.Path as Path;
bind Zanna.IO.File as File;
bind Zanna.IO.Dir as Dir;
bind "./art";

/// A skin far larger than the tile, drawn as a one-pixel checkerboard: point
/// sampling can only ever return one of the two extremes, so the averaged
/// mid-tone below is what separates a filtered reduction from an aliased one.
final OVERSIZED = 256;

var scratch = "";

func fail(message: String) {
    if scratch != "" { Dir.RemoveAll(scratch); }
    Terminal.Say("FAIL: " + message);
    Env.Exit(1);
}
func require(ok: Boolean, message: String) {
    if !ok { fail(message); }
}

/// @brief Write a two-tone one-pixel checkerboard of the given size.
func checkerboard(path: String, size: Integer) {
    var p = Pixels.New(size, size);
    for y in 0..size {
        for x in 0..size {
            var tone = 0x000000FF; if (x + y) % 2 == 0 { tone = 0xFFFFFFFF; }
            p.SetRgba(x, y, tone);
        }
    }
    require(p.SavePng(path) == 1, "write oversized PNG fixture");
}

func start() {
    var dir = Env.GetVariable("CATNMOUSE_ASSETS");
    if dir == "" {
        // Own the scratch directory so the probe is repeatable and manifest-driven.
        dir = Path.Join(Machine.TempDir, "catnmouse-skin-probe");
        Dir.RemoveAll(dir);
        Dir.MakeAll(dir);
        require(Dir.Exists(dir), "create scratch directory " + dir);
        scratch = dir;
        Env.SetVariable("CATNMOUSE_ASSETS", dir);
    } else {
        require(!File.Exists(Path.Join(dir, "mouse.png")) && !File.Exists(Path.Join(dir, "crate.png")),
                "fixture targets must not exist");
    }
    var p = Pixels.New(2, 2); p.SetRgba(1, 1, 0xFF000080);
    require(p.SavePng(Path.Join(dir, "mouse.png")) == 1, "write PNG fixture");
    File.WriteAllText(Path.Join(dir, "crate.png"), "invalid PNG fixture");
    var bank = new art.Art();
    require(bank.overrides == 1, "one PNG override; invalid PNG falls back");
    require(bank.sprites.get(4).GetRgba(63, 63) == 0xFF000080, "PNG resize preserves RGBA");
    require(bank.sprites.get(4).GetRgba(0, 0) == 0, "PNG transparent corners preserved");
    require(bank.sprites.get(2).GetRgba(32, 38) == art.generate(2).GetRgba(32, 38), "corrupt fallback");
    require(bank.crateLarge.Width == 128 && bank.crateLarge.Height == 128, "fallback crate is cached at 2x");

    // An oversized skin must be area-averaged into the tile, not point-sampled.
    checkerboard(Path.Join(dir, "crate.png"), OVERSIZED);
    var filtered = new art.Art();
    require(filtered.overrides == 2, "both fixtures now override");
    var tile = filtered.sprites.get(2);
    require(tile.Width == 64 && tile.Height == 64, "oversized skin lands at tile size");
    var grey = (tile.GetRgba(32, 32) / 16777216) % 256;
    require(grey > 96 && grey < 160, "oversized skin is averaged, not point-sampled");
    require(tile.GetRgba(32, 32) % 256 == 255, "opaque skin stays opaque");
    require(filtered.crateLarge.Width == 128, "crate skin is cached at 2x");

    if scratch != "" { Dir.RemoveAll(scratch); }
    Terminal.Say("RESULT: ok");
}
