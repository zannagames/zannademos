// File: zannademos/catnmouse/sound.zia
// Purpose: Synthesize a looping heist soundtrack and independent UI/game effects.
// Key invariants:
//   - Missing audio support or devices never prevent playing the game.
//   - Music and effects have independent switches; focus loss silences music.
// Ownership/Lifetime:
//   - Audio owns two songs (menu, heist), one sound bank, and the active looping voice.
// Links: main.zia, profile.zia, docs/zannalib/audio.md
//===----------------------------------------------------------------------===//
module sound;
bind Zanna.Audio;

func note(song: MusicGen, channel: Integer, at: Integer, pitch: Integer, duration: Integer) {
    var _ = song.AddNote(channel, at, pitch, duration);
}

/// @brief A short melodic sting: one lead voice, one note per 100 ticks.
func sting(notes: List[Integer], tempo: Integer, waveform: Integer) -> Sound {
    var song = MusicGen.New(tempo);
    var lead = song.AddChannel(waveform);
    song.SetEnvelope(lead, 2, 80, 20, 120); song.SetChannelVolume(lead, 40);
    for i in 0..notes.length() { note(song, lead, i * 100, notes.get(i), 90); }
    song.Length = notes.length() * 100 + 100; song.SetLoopable(false); return song.Build();
}

/// @brief The heist loop: faster, lower and more insistent than the menu tune.
func buildHeist() -> Sound {
    var song = MusicGen.New(128);
    var lead = song.AddChannel(1); var bass = song.AddChannel(3); var tick = song.AddChannel(0);
    song.SetEnvelope(lead, 2, 90, 14, 110); song.SetChannelVolume(lead, 40); song.SetPan(lead, 12);
    song.SetEnvelope(bass, 3, 70, 30, 80); song.SetChannelVolume(bass, 34);
    song.SetEnvelope(tick, 1, 30, 4, 30); song.SetChannelVolume(tick, 12); song.SetDuty(tick, 12); song.SetPan(tick, -20);
    var roots: List[Integer] = [40, 40, 43, 43, 38, 38, 41, 47];
    var melody: List[Integer] = [64, 67, 71, 67, 64, 62, 64, 59,
        67, 71, 74, 71, 67, 66, 67, 62, 62, 65, 69, 65,
        62, 60, 62, 57, 65, 69, 72, 69, 71, 69, 66, 64];
    for bar in 0..8 {
        var root = roots.get(bar); var at = bar * 400;
        note(song, bass, at, root, 90); note(song, bass, at + 150, root, 40);
        note(song, bass, at + 200, root + 7, 90); note(song, bass, at + 300, root + 5, 90);
        for beat in 0..4 {
            note(song, lead, at + beat * 100, melody.get(bar * 4 + beat), 55);
            note(song, tick, at + beat * 100 + 50, root + 36, 12);
        }
    }
    song.Length = 3200; song.SetLoopable(true); return song.Build();
}

/// @brief An original eight-bar, swung minor-key chiptune, generated once.
func buildMusic() -> Sound {
    var song = MusicGen.New(108);
    var lead = song.AddChannel(0); var bass = song.AddChannel(3); var pluck = song.AddChannel(1);
    song.SetEnvelope(lead, 3, 110, 16, 140); song.SetChannelVolume(lead, 48); song.SetPan(lead, -15);
    song.SetEnvelope(bass, 4, 90, 35, 90); song.SetChannelVolume(bass, 32);
    song.SetEnvelope(pluck, 2, 55, 8, 50); song.SetChannelVolume(pluck, 15);
    song.SetDuty(pluck, 20); song.SetPan(pluck, 22); song.SetSwing(16);
    var roots: List[Integer] = [45, 45, 50, 50, 53, 50, 52, 52];
    var melody: List[Integer] = [69, 72, 76, 72, 74, 72, 69, 67,
        74, 77, 81, 77, 76, 74, 72, 69, 77, 81, 84, 81,
        77, 74, 72, 69, 76, 80, 83, 80, 76, 74, 71, 68];
    for bar in 0..8 {
        var root = roots.get(bar); var at = bar * 400;
        note(song, bass, at, root, 125); note(song, bass, at + 200, root + 7, 125);
        for beat in 0..4 {
            note(song, lead, at + beat * 100, melody.get(bar * 4 + beat), 65);
            note(song, pluck, at + beat * 100 + 50, root + 24, 25);
        }
    }
    song.Length = 3200; song.SetLoopable(true); return song.Build();
}

class Audio {
    hide SoundBank bank;
    hide Sound music;
    hide Sound heist;
    hide Integer voice;
    hide Boolean playingHeist;
    expose Boolean ready;

    expose func init() {
        voice = -1; ready = false; music = null; heist = null; bank = null; playingHeist = false;
        if !Mixer.IsAvailable() || Mixer.Init() == 0 { return; }
        bank = SoundBank.New();
        self.register("push", Synth.Sweep(150, 80, 80, 3));
        self.register("cheese", Synth.Sweep(780, 1400, 100, 0));
        self.register("capture", Synth.Sweep(380, 1500, 200, 1));
        self.register("death", sting([67, 63, 60, 55, 48], 150, 1));
        self.register("clear", sting([60, 64, 67, 72, 76, 79], 190, 0));
        self.register("menu", Synth.Tone(700, 35, 3));
        self.register("blocked", Synth.Tone(120, 60, 3));
        self.register("bonus", Synth.Sweep(900, 1800, 160, 0));
        self.register("exit", sting([64, 68, 71, 76, 71, 76, 83], 200, 0));
        self.register("spotted", Synth.Tone(200, 40, 2));
        self.register("drop", Synth.Sweep(220, 90, 70, 3));
        self.register("escape", Synth.Sweep(500, 900, 120, 1));
        music = buildMusic(); heist = buildHeist(); ready = true;
    }
    hide func register(name: String, effect: Sound) {
        if effect != null { var _ = bank.RegisterSound(name, effect); }
    }
    /// @brief Menus play the pantry tune; live play switches to the heist loop.
    expose func configure(enabled: Boolean, focused: Boolean, paused: Boolean) {
        if !ready || music == null || heist == null { return; }
        if !enabled { if voice > 0 { Voice.Stop(voice); voice = -1; } return; }
        var volume = 25;
        if paused { volume = 18; } if !focused { volume = 0; }
        var wantHeist = !paused;
        if voice > 0 && wantHeist != playingHeist { Voice.Stop(voice); voice = -1; }
        if voice < 0 {
            playingHeist = wantHeist;
            if wantHeist { voice = heist.PlayLoopGroup(volume, 0, 0); } else { voice = music.PlayLoopGroup(volume, 0, 0); }
        } else { Voice.SetVolume(voice, volume); }
    }
    expose func play(event: Integer, enabled: Boolean) {
        if !ready || !enabled { return; }
        var name = "";
        if event == 1 { name = "push"; } if event == 2 { name = "cheese"; }
        if event == 3 { name = "capture"; } if event == 4 { name = "death"; }
        if event == 5 { name = "clear"; } if event == 6 { name = "menu"; }
        if event == 7 { name = "blocked"; } if event == 8 { name = "bonus"; }
        if event == 9 { name = "exit"; } if event == 10 { name = "spotted"; }
        if event == 11 { name = "drop"; } if event == 12 { name = "escape"; }
        if name != "" { var _ = bank.Play(name, 42, 0); }
    }
    expose func shutdown() {
        if !ready { return; }
        if voice > 0 { Voice.Stop(voice); }
        bank.Clear(); Mixer.StopAllSounds(); Mixer.Shutdown(); ready = false;
    }
}
