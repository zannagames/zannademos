// File: zannademos/catnmouse/main.zia
// Purpose: Run the complete Cat 'n' Mouse campaign with keyboard and audio.
// Key invariants:
//   - A held direction repeats only while the board is live; menus never advance time.
//   - Real time advances in whole 100 ms ticks accumulated from the frame clock.
//   - Every BeginFrame is paired with Flip; focus loss pauses gameplay.
// Ownership/Lifetime:
//   - App owns the board, view, canvas and optional sound bank for one run.
// Links: DESIGN.md, README.md, rules.zia, view.zia
//===----------------------------------------------------------------------===//
module main;
bind Zanna.Graphics;
bind Zanna.Input.Mouse as Mouse;
bind Zanna.System.Environment as Env;
bind Zanna.Terminal as Terminal;
bind Zanna.Time.Clock as Clock;
bind Zanna.String as Str;
bind "./rules";
bind "./rooms";
bind "./view";
bind "./art";
bind "./profile";
bind "./session";
bind "./menus";
bind "./sound";
bind "./controls";

class App {
    hide Canvas canvas;
    hide session.Session flow;
    hide view.View screen;
    hide menus.Menus front;
    hide sound.Audio audio;
    hide controls.Controls input;
    hide Integer transition;
    hide Integer particles;
    hide Integer particleKind;
    hide Integer animation;
    hide Integer mouseX;
    hide Integer mouseY;
    hide Boolean smoke;
    hide Integer frames;
    hide Integer tickMs;
    hide Integer label;
    hide Integer labelX;
    hide Integer labelY;
    hide String labelText;
    hide Integer shake;
    hide Integer flash;
    hide Integer flashColor;
    hide Integer wipe;
    hide Integer particleX;
    hide Integer particleY;

    expose func init(seed: Integer, windowSmoke: Boolean) {
        smoke = windowSmoke; frames = 0;
        var key = "catnmouse"; if smoke { key = "catnmouse-window-smoke"; }
        var prefs = new profile.Profile(key);
        if !smoke { var _ = prefs.load(); }
        flow = new session.Session(seed, prefs, !smoke);
        screen = new view.View(); front = new menus.Menus(screen);
        canvas = Canvas.New("Cat 'n' Mouse - The Midnight Cheese Heist", view.WIDTH, view.HEIGHT);
        canvas.SetFps(60); canvas.SetMaxDeltaTime(100);
        input = new controls.Controls(); audio = new sound.Audio();
        transition = 180; particles = 0; particleKind = 0; animation = 0;
        tickMs = 0; label = 0; labelX = 0; labelY = 0; labelText = "";
        shake = 0; flash = 0; flashColor = art.PAPER; wipe = 0; particleX = 0; particleY = 0;
        mouseX = Mouse.X(); mouseY = Mouse.Y();
    }

    hide func render() {
        front.controller = input.lastPad;
        if flow.mode == session.TITLE || flow.mode == session.PAUSE ||
           flow.mode == session.SETTINGS || flow.mode == session.SCORES ||
           flow.mode == session.INITIALS {
            front.draw(flow);
        } else {
            screen.phase = tickMs; screen.recordRank = flow.lastRank;
            screen.draw(flow.game, flow.mode, flow.prefs.lanes, !flow.prefs.music);
            screen.inputHints(input.lastPad, flow.mode, flow.game);
            if flow.prefs.notice != "" {
                screen.pixels.DrawBox(32, view.FOOT, 980, 12, art.PAPER);
                screen.pixels.DrawText(33, view.FOOT, flow.prefs.notice, art.RED);
            }
        }
    }

    hide func pointer() -> Boolean {
        var x = Mouse.X(); var y = Mouse.Y();
        var moved = x != mouseX || y != mouseY; mouseX = x; mouseY = y;
        var hit = menus.hit(flow.mode, x, y);
        var redraw = false;
        flow.event = 0;
        if moved && hit >= 0 && hit < flow.menuCount() { redraw = flow.hover(hit); }
        if Mouse.WasPressed(Mouse.ButtonLeft) && hit >= 0 {
            input.lastPad = false;
            if flow.mode == session.SCORES {
                if hit == 100 { redraw = flow.command("escape"); }
                else { flow.scoreTab = hit; redraw = true; }
            } else if flow.mode == session.INITIALS {
                if hit == 100 { redraw = flow.command("enter"); }
                else { flow.cursor = hit; redraw = true; }
            } else if flow.mode == session.HELP || flow.mode == session.SURRENDER ||
                      flow.mode == session.QUIT || flow.mode == session.RESTART {
                if hit == 101 { redraw = flow.command("escape"); } else { redraw = flow.command("enter"); }
            } else {
                flow.selected = hit; redraw = flow.command("enter");
            }
        }
        return redraw;
    }

    /// @brief Screen-shake offset for this frame, derived from the animation clock (no RNG).
    hide func jitter(axis: Integer) -> Integer {
        if shake <= 0 || !flow.prefs.motion { return 0; }
        var amp = 2 + shake / 120;
        var n = (animation / 16 + axis * 7) % 4;
        if n == 0 { return amp; } if n == 1 { return 0 - amp; } if n == 2 { return amp / 2; }
        return 0 - amp / 2;
    }

    hide func accents(dt: Integer) {
        if !flow.prefs.motion { transition = 0; particles = 0; shake = 0; flash = 0; wipe = 0; return; }
        animation = (animation + dt) % 4000;
        if shake > 0 { shake = shake - dt; if shake < 0 { shake = 0; } }
        if flow.mode == session.GAME && flow.game.state == rules.CAUGHT {
            var pulse = 70 + ((animation / 40) % 20) * 4;
            canvas.BoxAlpha(0, 0, view.WIDTH, 40, art.RED, pulse); canvas.BoxAlpha(0, view.HEIGHT - 40, view.WIDTH, 40, art.RED, pulse);
            canvas.BoxAlpha(0, 40, 28, view.HEIGHT - 80, art.RED, pulse); canvas.BoxAlpha(view.WIDTH - 28, 40, 28, view.HEIGHT - 80, art.RED, pulse);
        }
        if flow.mode == session.TITLE {
            var step = animation / 160;
            for i in 0..9 {
                var x = 766 + (i * 53) % 454;
                var y = 148 + (i * 71 + step * 2) % 566;
                canvas.BoxAlpha(x, y, 3, 3, art.GOLD, 55 + (i % 3) * 25);
            }
        }
        if particles > 0 && flow.mode == session.GAME {
            particles = particles - dt;
            if particles < 0 { particles = 0; }
            var elapsed = 400 - particles;
            var x = view.BX + particleX * art.SIZE + art.SIZE / 2;
            var y = view.BY + particleY * art.SIZE + art.SIZE / 2;
            var color = art.GOLD;
            if particleKind == 3 { color = 0xB0D6DA; }
            if particleKind == 4 || particleKind == 10 { color = art.RED; }
            if particleKind == 1 || particleKind == 11 { color = 0xC9A97A; }
            if particleKind == 9 || particleKind == 12 { color = art.GREEN; }
            var count = 8; if particleKind == 2 || particleKind == 8 || particleKind == 13 || particleKind == 3 { count = 12; }
            for i in 0..count {
                var ox = ((i % 4) * 2 - 3) * elapsed / 24 + (i / 4) * 3 - 3;
                var oy = ((i / 4) * 2 - 2) * elapsed / 18 - elapsed * elapsed / 6000;
                var size = 4; if i % 3 == 0 { size = 6; }
                canvas.BoxAlpha(x + ox, y + oy, size, size, color, particles * 190 / 400);
            }
        }
        if label > 0 && flow.mode == session.GAME {
            label = label - dt; if label < 0 { label = 0; }
            var rise = (700 - label) / 14;
            canvas.BoxAlpha(labelX - 4, labelY - rise - 4, 8 * 3 * 4 + 8, 32, art.INK, label * 160 / 700);
            canvas.TextScaled(labelX, labelY - rise, labelText, 3, art.GOLD);
        }
        if flash > 0 {
            flash = flash - dt; if flash < 0 { flash = 0; }
            canvas.BoxAlpha(0, 0, view.WIDTH, view.HEIGHT, flashColor, flash * 150 / 200);
        }
        if wipe > 0 {
            wipe = wipe - dt; if wipe < 0 { wipe = 0; }
            // A gold bar sweeps left to right, dragging a night-blue curtain across the board.
            var progress = (600 - wipe) * view.WIDTH / 600;
            if wipe > 300 { canvas.Box(0, 0, (600 - wipe) * view.WIDTH / 300, view.HEIGHT, art.NIGHT); }
            else { canvas.Box(progress, 0, view.WIDTH - progress, view.HEIGHT, art.NIGHT); }
            var bar = progress; if wipe > 300 { bar = (600 - wipe) * view.WIDTH / 300; }
            canvas.Box(bar - 6, 0, 12, view.HEIGHT, art.GOLD);
        }
        if transition > 0 {
            transition = transition - dt; if transition < 0 { transition = 0; }
            canvas.BoxAlpha(0, 0, view.WIDTH, view.HEIGHT, art.INK, transition * 200 / 180);
        }
    }

    /// @brief Sound, sparkles and floating score labels for the latest session event.
    hide func feedback() {
        audio.play(flow.event, flow.prefs.effects);
        var e = flow.event;
        if e == 1 || (e >= 2 && e <= 4) || e == 8 || e == 9 || e == 10 || e == 11 || e == 12 || e == 13 {
            particles = 400; particleKind = e;
            particleX = flow.game.mx; particleY = flow.game.my;
            if (e == 3 || e == 9 || e == 11 || e == 12 || e == 13) && flow.game.eventX >= 0 {
                particleX = flow.game.eventX; particleY = flow.game.eventY;
            }
        }
        if e == 10 { shake = 260; }
        if e == 4 { shake = 420; flash = 200; flashColor = art.RED; }
        if e == 3 { flash = 120; flashColor = art.PAPER; }
        if e == 9 { flash = 160; flashColor = art.GREEN; }
        if e == 5 && flow.game.state == rules.MAP { wipe = 600; }
        if e == 2 || e == 8 || e == 3 {
            label = 700; labelText = "+100"; if e == 8 { labelText = "+300"; } if e == 3 { labelText = "+250"; }
            labelX = view.BX + flow.game.mx * art.SIZE - 16; labelY = view.BY + flow.game.my * art.SIZE - 24;
            if e == 3 { labelX = view.BX + 600; labelY = view.BY + 100; }
        }
    }

    /// @brief A direction the mouse can walk right now (rooms are random, so the smoke asks).
    hide func freeMove() -> String {
        var g = flow.game;
        var names: List[String] = ["right", "down", "left", "up"];
        for d in 0..4 {
            var x = g.mx + rules.dx(d); var y = g.my + rules.dy(d);
            if g.tile(x, y) == 0 && g.catAt(x, y) < 0 { return names.get(d); }
        }
        return "wait";
    }

    hide func smokeAction() -> String {
        frames = frames + 1;
        if frames == 12 || frames == 36 || frames == 48 || frames == 60 { return "enter"; }
        if frames == 24 || frames == 100 { return "pause"; }
        if frames == 30 || frames == 42 || frames == 54 { return "down"; }
        if frames == 66 || frames == 72 || frames == 112 { return "escape"; }
        if frames == 84 || frames == 90 { return self.freeMove(); }
        if frames >= 120 {
            if flow.game.turn != 2 || flow.game.state != rules.PLAY || flow.prefs.music || flow.prefs.effects {
                Terminal.Say("FAIL: window smoke state"); Env.Exit(2);
            }
            flow.running = false;
        }
        return "";
    }

    expose func run() {
        self.render();
        while flow.running && canvas.BeginFrame() != 0 {
            var previousMode = flow.mode;
            var live = flow.mode == session.GAME && flow.game.state == rules.PLAY;
            var action = input.poll(canvas.DeltaTime, live && !smoke); var redraw = false;
            if smoke {
                action = self.smokeAction();
                if action != "" { redraw = flow.command(action); }
            } else if !canvas.IsFocused() || input.disconnected {
                redraw = flow.focusLost();
            } else {
                if action != "" { redraw = flow.command(action); }
                if !redraw { redraw = self.pointer(); }
            }
            if redraw { self.feedback(); }
            if !smoke && flow.mode == session.GAME {
                screen.advance(canvas.DeltaTime);
                tickMs = tickMs + canvas.DeltaTime;
                while tickMs >= 100 {
                    tickMs = tickMs - 100;
                    if flow.tick() { redraw = true; self.feedback(); }
                }
                redraw = true;
            } else { tickMs = 0; }
            if redraw {
                if previousMode != flow.mode { transition = 180; }
                self.render();
            }
            audio.configure(flow.prefs.music, canvas.IsFocused(), flow.mode != session.GAME);
            if shake > 0 { canvas.Clear(art.NIGHT); }
            canvas.Blit(self.jitter(0), self.jitter(1), screen.pixels);
            self.accents(canvas.DeltaTime);
            canvas.Flip();
        }
        audio.shutdown();
    }
}

func usage() {
    Terminal.Say("Usage: catnmouse [--seed N] [--smoke | --window-smoke] [--screenshot PATH] [--screen board|menu|settings|scores]");
    Env.Exit(1);
}

/// @brief Parse a bounded unsigned seed without trapping on malformed input.
func seedNumber(s: String) -> Integer {
    var value = 0; var length = Str.get_Length(s);
    if length == 0 || length > 10 { return -1; }
    for i in 0..length {
        var digit = Str.ByteAt(s, i) - 48;
        if digit < 0 || digit > 9 { return -1; }
        value = value * 10 + digit;
        if value > 2147483646 { return -1; }
    }
    return value;
}

func start() {
    var seed = Clock.NowMs() % 2147483647;
    var smoke = false; var windowSmoke = false; var screenshot = ""; var screenName = "board";
    var i = 0;
    while i < Env.GetArgumentCount() {
        var arg = Env.GetArgument(i);
        // Native argv[0] is a program name; VM argument lists may omit it.
        if i == 0 && Env.IsNative() && Str.Left(arg, 2) != "--" { i = i + 1; continue; }
        if arg == "--smoke" || arg == "--zanna-package-smoke" { smoke = true; }
        else if arg == "--window-smoke" { windowSmoke = true; }
        else if arg == "--seed" || arg == "--screenshot" || arg == "--screen" {
            i = i + 1;
            if i >= Env.GetArgumentCount() { usage(); return; }
            var value = Env.GetArgument(i);
            if arg == "--seed" { seed = seedNumber(value); if seed < 0 { usage(); return; } }
            else if arg == "--screen" {
                screenName = value;
                if value != "board" && value != "menu" && value != "settings" && value != "scores" { usage(); return; }
            } else { screenshot = value; if screenshot == "" { usage(); return; } }
        } else { usage(); return; }
        i = i + 1;
    }
    if windowSmoke && (smoke || screenshot != "") { usage(); return; }
    if screenName != "board" && screenshot == "" { usage(); return; }
    if smoke || screenshot != "" {
        var game = new rules.Board(); game.seed = seed; rooms.load(game, 0);
        var screen = new view.View(); screen.draw(game, 0, true, true);
        if screenName != "board" {
            var prefs = new profile.Profile("catnmouse-preview");
            var flow = new session.Session(seed, prefs, false);
            if screenName == "settings" { flow.mode = session.SETTINGS; }
            if screenName == "scores" { flow.mode = session.SCORES; }
            var front = new menus.Menus(screen); front.draw(flow);
        }
        if screenshot != "" && screen.pixels.SavePng(screenshot) == 0 {
            Terminal.Say("Could not save screenshot."); Env.Exit(1); return;
        }
        if game.cheese.length() != 12 || game.danger(game.mx, game.my) { Env.Exit(2); return; }
        Terminal.Say("RESULT: ok"); return;
    }
    var app = new App(seed, windowSmoke); app.run();
    if windowSmoke { Terminal.Say("RESULT: ok"); }
}
