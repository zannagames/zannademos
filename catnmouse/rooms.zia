// File: zannademos/catnmouse/rooms.zia
// Purpose: Generate the ten rooms and their linear campaign metadata.
// Key invariants:
//   - Only the boundary is fixed; every interior block is a pushable crate.
//   - No cat can see the entrance when a room begins; a grace period follows.
// Ownership/Lifetime:
//   - Layout construction mutates the supplied board, retaining campaign lives.
// Links: rules.zia, DESIGN.md
//===----------------------------------------------------------------------===//
module rooms;
bind "./rules";

expose func name(n: Integer) -> String {
    if n == 0 { return "THE PANTRY"; }
    if n == 1 { return "SCULLERY"; }
    if n == 2 { return "BREAKFAST NOOK"; }
    if n == 3 { return "THE BOX ROOM"; }
    if n == 4 { return "LONG GALLERY"; }
    if n == 5 { return "THE LIBRARY"; }
    if n == 6 { return "LAUNDRY DAY"; }
    if n == 7 { return "ATTIC CROSSING"; }
    if n == 8 { return "THE CATWALK"; }
    return "MIDNIGHT FEAST";
}

expose func hint(n: Integer) -> String {
    if n == 0 { return "Sentries glow when they search. Stay out of their lanes."; }
    if n == 1 { return "Box in the tan stalker after the cheese to open the exit."; }
    if n == 2 { return "Grab the star bonus before it hops elsewhere."; }
    if n == 3 { return "Two tan cats now. Box them both in after the cheese."; }
    if n == 4 { return "Purple prowlers wander faster. Keep cover close."; }
    if n == 5 { return "A safe passage now may become a firing lane."; }
    if n == 6 { return "Every roaming cat must go. Sentries can stay."; }
    if n == 7 { return "The exit only appears once the cheese is done."; }
    if n == 8 { return "Fewer crates. Every push leaves a lasting mark."; }
    return "Twelve cheese. Four cats. One last way out.";
}

/// @brief Floor connectivity keeps initial cheese and bonus positions reachable.
expose func connected(g: rules.Board) -> Boolean {
    var seen: List[Integer] = [];
    for _ in 0..rules.W * rules.H { seen.add(0); }
    var queue: List[Integer] = [g.my * rules.W + g.mx];
    seen.set(queue.get(0), 1); var head = 0;
    while head < queue.length() {
        var pos = queue.get(head); head = head + 1;
        for d in 0..4 {
            var x = pos % rules.W + rules.dx(d); var y = pos / rules.W + rules.dy(d);
            if g.tile(x, y) == 0 && seen.get(y * rules.W + x) == 0 {
                seen.set(y * rules.W + x, 1); queue.add(y * rules.W + x);
            }
        }
    }
    for y in 1..rules.H - 1 { for x in 1..rules.W - 1 {
        if g.tile(x, y) == 0 && seen.get(y * rules.W + x) == 0 { return false; }
    } }
    return true;
}

func cat(g: rules.Board, kind: Integer) {
    var cells: List[Integer] = [];
    for y in 2..rules.H - 1 { for x in 2..rules.W - 1 {
        if g.tile(x, y) == 0 && g.catAt(x, y) < 0 && !g.clear(x, y, g.mx, g.my) {
            var spaced = true;
            for i in 0..g.cats.length() {
                var c = g.cats.get(i);
                if rules.abs(c.x - x) + rules.abs(c.y - y) < 3 { spaced = false; }
            }
            if spaced { cells.add(y * rules.W + x); }
        }
    } }
    var pos = cells.get(g.random(cells.length()));
    g.addCat(pos % rules.W, pos / rules.W, kind);
}

/// @brief Restore this level's initial setup without rerolling it or rewinding campaign randomness.
expose func reload(g: rules.Board) {
    var currentSeed = g.seed;
    g.seed = g.layoutSeed;
    load(g, g.room);
    g.seed = currentSeed;
}

/// @brief Generate once on level entry, preserving the seed for explicit retries.
expose func load(g: rules.Board, n: Integer) {
    g.layoutSeed = g.seed;
    g.clearRoom(); g.room = n;
    // Keep the familiar protected entrance and v1.1.4 crate-count curve.
    g.setTile(3, 1, 2); g.setTile(1, 3, 2);
    var cells: List[Integer] = [];
    for y in 2..rules.H - 1 { for x in 2..rules.W - 1 { cells.add(y * rules.W + x); } }
    var placed = 0; var target = 18 - n / 2;
    while placed < target && cells.length() > 0 {
        var index = g.random(cells.length()); var pos = cells.get(index);
        cells.set(index, cells.get(cells.length() - 1)); cells.removeAt(cells.length() - 1);
        g.setTile(pos % rules.W, pos / rules.W, 2);
        if connected(g) { placed = placed + 1; }
        else { g.setTile(pos % rules.W, pos / rules.W, 0); }
    }
    g.mustClear = n >= 1;
    g.interval = 10;
    if n >= 3 { g.interval = 8; } if n >= 7 { g.interval = 6; }
    if g.difficulty == 0 { g.interval = g.interval + 4; }
    if g.difficulty == 2 { g.interval = g.interval - 2; }
    var kind = 0;
    if n >= 1 { kind = 1; } if n >= 7 { kind = 2; }
    cat(g, kind);
    var second = 0;
    if n >= 3 { second = 1; }
    cat(g, second);
    if n >= 2 {
        var third = 1; if n >= 4 { third = 2; }
        cat(g, third);
    }
    if n >= 6 { cat(g, 1); }

    g.scatter(); g.placeBonus(); g.event = 0; g.message = hint(n);
}
