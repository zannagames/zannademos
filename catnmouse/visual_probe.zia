// File: zannademos/catnmouse/visual_probe.zia
// Purpose: Verify sprite alpha, all screens and optional PNG screenshot export.
// Key invariants:
//   - No Canvas or audio device is created by this probe.
// Ownership/Lifetime:
//   - The probe owns one view and temporary comparison surfaces.
// Links: art.zia, view.zia, README.md
//===----------------------------------------------------------------------===//
module visual_probe;
bind Zanna.Graphics;
bind Zanna.Terminal as Terminal;
bind Zanna.System.Environment as Env;
bind Zanna.IO.Path as Path;
bind Zanna.Text.Fmt as Fmt;
bind "./art";
bind "./view";
bind "./rules";
bind "./rooms";
bind "./profile";
bind "./session";
bind "./menus";

func require(ok: Boolean, message: String) {
    if !ok { Terminal.Say("FAIL: " + message); Env.Exit(1); }
}
func save(v: view.View, name: String) {
    var dir = Env.GetVariable("CATNMOUSE_PREVIEW");
    if dir != "" { require(v.pixels.SavePng(Path.Join(dir, name + ".png")) == 1, "PNG export"); }
}
func start() {
    for id in 0..art.COUNT {
        var sprite = art.generate(id);
        require(sprite.Width == 64 && sprite.Height == 64, "requested sprite dimensions");
        if id >= 2 { require(sprite.GetRgba(0, 0) == 0, "transparent sprite corners"); }
        require(sprite.GetRgba(32, 38) != 0, "sprite interior is drawn");
    }
    var crate = art.generate(2);
    var shade = crate.GetRgba(60, 60) % 256;
    require(shade > 0 && shade < 255, "crate carries a translucent drop shadow");
    var glow = art.halo(art.GOLD);
    require(glow.Width == 96 && glow.GetRgba(48, 48) % 256 > 0 && glow.GetRgba(2, 2) % 256 == 0, "halo is soft and bounded");
    var target = RenderTarget2D.New(4, 4);
    var pixels = target.Pixels as Pixels;
    pixels.FillColor(0x0000FF);
    var overlay = Pixels.New(2, 2);
    overlay.SetRgba(1, 1, 0xFF000080);
    target.DrawPixels(0, 0, overlay);
    require(pixels.GetRgb(0, 0) == 0x0000FF, "transparent overlay preserves floor");
    require(pixels.GetRgb(1, 1) == 0x80007F, "partial alpha is composed");
    var v = new view.View(); var g = new rules.Board(); g.seed = 173;
    for n in 0..10 {
        rooms.load(g, n); v.draw(g, 0, true, false);
        require(v.pixels.Width == view.WIDTH && v.pixels.Height == view.HEIGHT, "frame dimensions");
        save(v, "room-" + Fmt.Int(n + 1));
    }
    rooms.load(g, 0);
    for mode in 3..6 { v.draw(g, mode, true, false); save(v, "screen-" + Fmt.Int(mode)); }
    v.draw(g, 9, true, false); save(v, "restart");
    g.grace = 0; g.cats.get(0).searching = true; v.draw(g, 0, true, false); save(v, "searching");
    g.collected = 12; g.cheese.clear(); g.revealExit(); v.draw(g, 0, true, false); save(v, "exit-shown");
    g.state = rules.CAUGHT; g.killer = 0; v.draw(g, 0, true, false); save(v, "caught");
    g.state = rules.PLAY; g.killer = -1;
    // Every effects level renders the same board geometry; only the overlays differ.
    var levels: List[String] = ["board-fx-off", "board-fx-simple", "board-fx-fancy"];
    for level in 0..3 {
        v.fx = level; v.draw(g, 0, true, false);
        require(v.pixels.Width == view.WIDTH && v.pixels.Height == view.HEIGHT, "effects level frame dimensions");
        save(v, levels.get(level));
    }
    v.fx = profile.FX_FANCY;
    var prefs = new profile.Profile("catnmouse-preview");
    var flow = new session.Session(173, prefs, false);
    var front = new menus.Menus(v);
    front.draw(flow); save(v, "menu");
    flow.mode = session.SETTINGS; front.draw(flow); save(v, "settings");
    prefs.fx = profile.FX_SIMPLE; front.draw(flow); save(v, "settings-fx-simple");
    prefs.fx = profile.FX_OFF; front.draw(flow); save(v, "settings-fx-off");
    prefs.fx = profile.FX_FANCY;
    flow.mode = session.SCORES; front.draw(flow); save(v, "scores-empty");
    // Demonstration records exist only in this screenshot probe's memory.
    prefs.add(new profile.Record("ACE", 31540, 10, 480, 1, true));
    prefs.add(new profile.Record("MOU", 24712, 8, 644, 1, false));
    prefs.add(new profile.Record("KIT", 18200, 6, 530, 1, false));
    prefs.add(new profile.Record("SAM", 7600, 3, 400, 1, false));
    front.draw(flow); save(v, "scores");
    flow.mode = session.INITIALS; front.draw(flow); save(v, "initials");
    flow.mode = session.PAUSE; flow.active = true; front.draw(flow); save(v, "pause");
    front.controller = true; front.draw(flow); save(v, "controller-pause");
    g.state = rules.DEAD; v.draw(g, 0, true, false); save(v, "death");
    g.state = rules.MAP; g.room = 4; v.draw(g, 0, true, false); save(v, "map");
    g.state = rules.OVER; g.message = "Out of lives."; v.draw(g, 0, true, false); save(v, "game-over");
    rooms.load(g, 9); g.cats.clear(); g.cheese.clear();
    g.state = rules.WON; g.room = 10; g.collected = 12; g.totalTurns = 431;
    g.captures = 14; g.mx = g.ex; g.my = g.ey;
    v.draw(g, 0, true, false); save(v, "victory");
    rooms.load(g, 0); v.draw(g, 0, false, true); save(v, "no-lanes");
    Terminal.Say("RESULT: ok");
}
