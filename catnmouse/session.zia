// File: zannademos/catnmouse/session.zia
// Purpose: Coordinate menus, persistent preferences and one active campaign.
// Key invariants:
//   - Menu commands cannot advance the board; only tick() advances real time.
//   - Difficulty locks at run start; a catch walk disables movement input.
//   - Each finished campaign contributes at most one leaderboard record.
// Ownership/Lifetime:
//   - Session owns its board and borrows the application's profile.
// Links: main.zia, menus.zia, profile.zia, session_probe.zia
//===----------------------------------------------------------------------===//
module session;
bind Zanna.String as Str;
bind "./rules";
bind "./rooms";
bind "./profile";

final GAME = 0;
final TITLE = 1;
final PAUSE = 2;
final HELP = 3;
final SURRENDER = 4;
final QUIT = 5;
final SETTINGS = 6;
final SCORES = 7;
final INITIALS = 8;
final RESTART = 9;

class Session {
    expose rules.Board game;
    expose profile.Profile prefs;
    expose Integer mode;
    expose Integer selected;
    expose Integer scoreTab;
    expose Integer cursor;
    expose String draftName;
    expose Integer event;
    expose Boolean active;
    expose Boolean running;
    hide Boolean persist;
    hide Boolean recorded;
    hide Integer nextSeed;
    hide Integer backMode;
    hide Integer helpBack;
    hide Integer quitBack;
    /// @brief 1-based rank of the last recorded run on its difficulty board, or 0.
    expose Integer lastRank;

    expose func init(seed: Integer, settings: profile.Profile, writeProfile: Boolean) {
        game = new rules.Board(); prefs = settings; nextSeed = seed; persist = writeProfile;
        game.seed = seed; rooms.load(game, 0);
        mode = TITLE; selected = 0; scoreTab = prefs.difficulty;
        cursor = 0; draftName = prefs.name; event = 0;
        active = false; running = true; recorded = false;
        backMode = TITLE; helpBack = TITLE; quitBack = TITLE; lastRank = 0;
    }
    expose func save() { if persist { var _ = prefs.save(); } }
    expose func begin() {
        game.difficulty = prefs.difficulty;
        game.maxLives = 5;
        if game.difficulty == 0 { game.maxLives = 7; }
        if game.difficulty == 2 { game.maxLives = 3; }
        game.lives = game.maxLives; game.totalTurns = 0; game.captures = 0; game.bonuses = 0;
        game.seed = nextSeed; nextSeed = (nextSeed + 1) % 2147483647;
        rooms.load(game, 0); mode = GAME; active = true; recorded = false; event = 5; lastRank = 0;
    }
    expose func finish() {
        if (game.state == rules.OVER || game.state == rules.WON) && !recorded && active {
            prefs.recordRun(game); self.save(); recorded = true; active = false;
            lastRank = 0;
            var points = profile.score(game);
            for rank in 0..10 {
                var r = prefs.entry(game.difficulty, rank);
                if r != null && r.points == points && r.turns == game.totalTurns && lastRank == 0 { lastRank = rank + 1; }
            }
        }
    }
    expose func focusLost() -> Boolean {
        if mode == GAME && (game.state == rules.PLAY || game.state == rules.CAUGHT) {
            mode = PAUSE; selected = 0; event = 0; return true;
        }
        return false;
    }
    /// @brief Advance one 100 ms simulation tick while the board is live; menus never tick.
    expose func tick() -> Boolean {
        event = 0;
        if mode != GAME { return false; }
        var changed = game.tick();
        event = game.event;
        if game.state == rules.OVER || game.state == rules.WON { self.finish(); }
        return changed;
    }
    expose func menuCount() -> Integer {
        if mode == TITLE || mode == PAUSE { return 5; }
        if mode == SETTINGS { return 7; }
        return 0;
    }
    expose func hover(row: Integer) -> Boolean {
        if row < 0 || row >= self.menuCount() || row == selected { return false; }
        selected = row; event = 6; return true;
    }
    hide func openSettings() { backMode = mode; mode = SETTINGS; selected = 0; }
    hide func openScores() { backMode = mode; mode = SCORES; scoreTab = prefs.difficulty; }
    hide func back() {
        if mode == INITIALS { mode = SETTINGS; selected = 5; }
        else if mode == SETTINGS || mode == SCORES { mode = backMode; selected = 0; }
        else if mode == HELP { mode = helpBack; }
        else if mode == QUIT { mode = quitBack; }
        else if mode == SURRENDER || mode == RESTART { mode = GAME; }
        else if mode == PAUSE { mode = GAME; }
        else if mode == GAME {
            if game.state == rules.OVER || game.state == rules.WON { mode = TITLE; selected = 0; }
            else { mode = PAUSE; selected = 0; }
        } else if mode == TITLE {
            if active { quitBack = TITLE; mode = QUIT; } else { running = false; }
        }
    }
    hide func changeSetting(delta: Integer) {
        if selected == 0 { prefs.difficulty = (prefs.difficulty + delta + 3) % 3; }
        if selected == 1 { prefs.music = !prefs.music; }
        if selected == 2 { prefs.effects = !prefs.effects; }
        if selected == 3 { prefs.lanes = !prefs.lanes; }
        if selected == 4 { prefs.fx = (prefs.fx + delta + 3) % 3; }
        if selected == 5 { draftName = prefs.name; cursor = 0; mode = INITIALS; }
        if selected == 6 { self.back(); return; }
        self.save();
    }
    hide func confirmMenu() {
        if selected == 0 {
            if active { mode = GAME; } else { self.begin(); }
        } else if selected == 1 { self.openSettings(); }
        else if selected == 2 { self.openScores(); }
        else if selected == 3 { helpBack = mode; mode = HELP; }
        else if mode == PAUSE { mode = TITLE; selected = 0; }
        else if active { quitBack = TITLE; mode = QUIT; }
        else { running = false; }
    }

    /// @brief Handle one named action, independent of native input and graphics.
    expose func command(action: String) -> Boolean {
        event = 0;
        if action == "escape" { self.back(); event = 6; return true; }
        if action == "mute" { prefs.music = !prefs.music; self.save(); return true; }
        if action == "effects" { prefs.effects = !prefs.effects; self.save(); return true; }
        if action == "lanes" { prefs.lanes = !prefs.lanes; self.save(); return true; }
        if action == "help" {
            if mode == HELP { mode = helpBack; } else { helpBack = mode; mode = HELP; }
            return true;
        }
        if mode == INITIALS {
            if action == "left" { cursor = (cursor + 2) % 3; }
            else if action == "right" { cursor = (cursor + 1) % 3; }
            else if action == "up" || action == "down" {
                var delta = 1; if action == "down" { delta = -1; }
                var index = (Str.ByteAt(draftName, cursor) - 65 + delta + 26) % 26;
                var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
                draftName = Str.Substring(draftName, 0, cursor) + Str.Substring(alphabet, index, 1) +
                            Str.Substring(draftName, cursor + 1, 2 - cursor);
            } else if action == "enter" {
                prefs.name = draftName; self.save(); mode = SETTINGS; selected = 5;
            } else { return false; }
            event = 6; return true;
        }
        if mode == SCORES {
            if action == "left" { scoreTab = (scoreTab + 2) % 3; }
            else if action == "right" { scoreTab = (scoreTab + 1) % 3; }
            else if action == "enter" { self.back(); }
            else { return false; }
            event = 6; return true;
        }
        if mode == HELP { if action == "enter" { self.back(); return true; } return false; }
        if mode == QUIT { if action == "enter" { running = false; return true; } return false; }
        if mode == SURRENDER {
            if action != "enter" { return false; }
            game.lose(); mode = GAME; event = 4; self.finish(); return true;
        }
        if mode == RESTART {
            if action != "enter" { return false; }
            var room = game.room;
            if game.restart() { rooms.load(game, room); }
            mode = GAME; event = 4; self.finish(); return true;
        }
        if self.menuCount() > 0 {
            if action == "pause" && mode == PAUSE { mode = GAME; return true; }
            if action == "up" { selected = (selected + self.menuCount() - 1) % self.menuCount(); }
            else if action == "down" { selected = (selected + 1) % self.menuCount(); }
            else if mode == SETTINGS && (action == "left" || action == "right" || action == "enter") {
                var delta = 1; if action == "left" { delta = -1; } self.changeSetting(delta);
            } else if action == "enter" { self.confirmMenu(); }
            else { return false; }
            if event == 0 { event = 6; } return true;
        }
        if action == "pause" { mode = PAUSE; selected = 0; return true; }
        if action == "restart" && (game.state == rules.PLAY || game.state == rules.CAUGHT || game.state == rules.DEAD) {
            mode = RESTART; return true;
        }
        if game.state == rules.CAUGHT { return false; }
        if game.state != rules.PLAY {
            if action != "enter" { return false; }
            if game.state == rules.DEAD { game.resume(); self.finish(); }
            else if game.state == rules.MAP { rooms.load(game, game.room); }
            else { backMode = TITLE; mode = SCORES; scoreTab = game.difficulty; }
            return true;
        }
        if action == "surrender" { mode = SURRENDER; return true; }
        var moved = false;
        if action == "up" { moved = game.step(0, -1); }
        else if action == "down" { moved = game.step(0, 1); }
        else if action == "left" { moved = game.step(-1, 0); }
        else if action == "right" { moved = game.step(1, 0); }
        else if action == "wait" { moved = game.step(0, 0); }
        else { return false; }
        event = game.event;
        if !moved { event = 7; }
        self.finish(); return true;
    }
}
