//
// File: zannademos/catnmouse/tools/make_skins.zia
// Purpose: Derive the violet prowler skin from the shipped blue stalker skin.
// Key invariants:
//   - Output is written only to the project's own assets directory.
//   - Alpha, luminance and the blue eyes of the source portrait are preserved;
//     only fur hue and saturation change, so the three cats stay one family.
//   - The transform is pure and deterministic: rerunning reproduces the file.
// Ownership/Lifetime:
//   - This offline tool owns its temporary pixel surfaces.
// Links: ../assets/README.md, ../art.zia
//
//===----------------------------------------------------------------------===//
module make_skins;

bind Zanna.Graphics;
bind Zanna.Terminal as Terminal;
bind Zanna.System.Environment as Env;

final SOURCE = "assets/cat_stalker.png";
final TARGET = "assets/cat_prowler.png";

/// Violet hue in [0,1); the procedural prowler fur (0x9C83B6) sits here.
final HUE = 0.755;
/// Fur saturation: the source portrait's own chroma, nudged up by a floor and
/// then capped on a lightness ramp so shadows carry the violet and the highlights
/// stay a pale lilac instead of going neon.
final SAT_GAIN = 0.95;
final SAT_FLOOR = 0.08;
final SAT_CAP_LIGHT = 0.17;
final SAT_CAP_DARK = 0.62;
/// A pixel whose blue channel leads red by this much belongs to an eye.
final EYE_LEAD = 16;

/// @brief One HSL hue ramp segment.
/// @param p Lower ramp bound.
/// @param q Upper ramp bound.
/// @param t Hue offset, wrapped into [0,1).
/// @return The channel value for this segment.
func hueChannel(p: Float, q: Float, t: Float) -> Float {
    var h = t;
    if h < 0.0 { h = h + 1.0; }
    if h > 1.0 { h = h - 1.0; }
    if h < 1.0 / 6.0 { return p + (q - p) * 6.0 * h; }
    if h < 0.5 { return q; }
    if h < 2.0 / 3.0 { return p + (q - p) * (2.0 / 3.0 - h) * 6.0; }
    return p;
}

/// @brief Pack one HSL ramp value as a 0..255 channel.
/// @param v Ramp output, nominally in [0,1] but clamped against rounding.
/// @return The byte value; `as Integer` rounds, so 1.0 must not reach 256.
func channel(v: Float) -> Integer {
    var scaled = v * 255.0;
    if scaled < 0.0 { scaled = 0.0; }
    if scaled > 255.0 { scaled = 255.0; }
    return scaled as Integer;
}

/// @brief Recolour one opaque pixel to the target hue, keeping its lightness.
/// @param r Source red 0..255.
/// @param g Source green 0..255.
/// @param b Source blue 0..255.
/// @return Packed 0xRRGGBB with the alpha byte left to the caller.
func revoice(r: Integer, g: Integer, b: Integer) -> Integer {
    var rf = r as Float / 255.0;
    var gf = g as Float / 255.0;
    var bf = b as Float / 255.0;
    var high = rf; if gf > high { high = gf; } if bf > high { high = bf; }
    var low = rf; if gf < low { low = gf; } if bf < low { low = bf; }
    var l = (high + low) / 2.0;
    var s = 0.0;
    if high > low {
        var d = high - low;
        if l > 0.5 { s = d / (2.0 - high - low); } else { s = d / (high + low); }
    }
    s = s * SAT_GAIN + SAT_FLOOR;
    var cap = SAT_CAP_LIGHT + (SAT_CAP_DARK - SAT_CAP_LIGHT) * (1.0 - l);
    if s > cap { s = cap; }
    var q = l + s - l * s;
    if l < 0.5 { q = l * (1.0 + s); }
    var p = 2.0 * l - q;
    return channel(hueChannel(p, q, HUE + 1.0 / 3.0)) * 65536
         + channel(hueChannel(p, q, HUE)) * 256
         + channel(hueChannel(p, q, HUE - 1.0 / 3.0));
}

func start() {
    var source = Pixels.LoadPng(SOURCE);
    if source == null {
        Terminal.Say("make_skins: cannot read " + SOURCE + " (run from the catnmouse directory)");
        Env.Exit(1);
        return;
    }
    var out = Pixels.New(source.Width, source.Height);
    for y in 0..source.Height {
        for x in 0..source.Width {
            var rgba = source.GetRgba(x, y);
            var a = rgba % 256;
            if a == 0 { continue; }
            var r = (rgba / 16777216) % 256;
            var g = (rgba / 65536) % 256;
            var b = (rgba / 256) % 256;
            var rgb = revoice(r, g, b);
            // Blue eyes are the portrait's signature; leave them untouched.
            if b > r + EYE_LEAD { rgb = r * 65536 + g * 256 + b; }
            out.SetRgba(x, y, rgb * 256 + a);
        }
    }
    if out.SavePng(TARGET) != 1 {
        Terminal.Say("make_skins: cannot write " + TARGET);
        Env.Exit(1);
        return;
    }
    Terminal.Say("make_skins: wrote " + TARGET);
}
