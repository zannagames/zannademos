// File: zannademos/catnmouse/generator_probe.zia
// Purpose: Prove every generated room is playable and stays solvable under cat drops.
// Key invariants:
//   - Ten rooms x many seeds: one floor region, covered start, nobody boxed, crate bounds.
//   - Same seed, same room; the repair path terminates and also yields a valid room.
//   - The crate cap holds forever and drops never cut the mouse off from its objectives.
// Ownership/Lifetime:
//   - Each scenario owns its board; nothing here opens a window or touches the profile.
// Links: rooms.zia, rules.zia, README.md
//===----------------------------------------------------------------------===//
module generator_probe;
bind Zanna.Terminal as Terminal;
bind Zanna.System.Environment as Env;
bind Zanna.Text.Fmt as Fmt;
bind "./rules";
bind "./rooms";

func require(ok: Boolean, message: String) {
    if !ok { Terminal.Say("FAIL: " + message); Env.Exit(1); }
}

func signature(g: rules.Board) -> Integer {
    var value = g.mx + g.my * rules.W;
    for i in 0..g.tiles.length() { value = (value * 31 + g.tiles.get(i)) % 2147483647; }
    for i in 0..g.cats.length() { var c = g.cats.get(i); value = (value * 31 + c.x + c.y * rules.W + c.kind * 1000) % 2147483647; }
    for i in 0..g.cheese.length() { value = (value * 31 + g.cheese.get(i)) % 2147483647; }
    return (value * 31 + g.bonus + 1) % 2147483647;
}

/// @brief The full contract for a freshly loaded room n.
func contract(g: rules.Board, n: Integer, tag: String) {
    require(rooms.validate(g), "generated room passes validate " + tag);
    require(g.connected(), "single floor region " + tag);
    require(!g.exposed(g.mx, g.my) && g.grace == rules.GRACE, "covered entrance with grace " + tag);
    require(g.cheese.length() == 12 && g.bonus >= 0, "twelve cheese and a bonus " + tag);
    require(g.reachesAll(g.flood(g.mx, g.my)), "pickups reachable " + tag);
    var crates = g.crateCount();
    require(crates <= rules.MAX_CRATES, "crate cap at load " + tag);
    var sentries = 0; var roamers = 0; var stalkers = 0;
    for i in 0..g.cats.length() {
        var c = g.cats.get(i);
        if c.kind == 0 { sentries = sentries + 1; } else { roamers = roamers + 1; }
        if c.kind == 1 { stalkers = stalkers + 1; }
        if n <= 3 { require(c.kind != 2, "no prowlers before room five " + tag); }
        require(c.x == c.homeX && c.y == c.homeY && c.hold == 0, "cats start at home " + tag);
    }
    require(sentries == rooms.sentries(n) && roamers == rooms.roamers(n), "enemy recipe " + tag);
    if n >= 7 { require(stalkers >= 1, "late rooms keep a stalker " + tag); }
    for x in 0..rules.W { require(g.tile(x, 0) == 1 && g.tile(x, rules.H - 1) == 1, "boundary " + tag); }
    for y in 0..rules.H { require(g.tile(0, y) == 1 && g.tile(rules.W - 1, y) == 1, "boundary " + tag); }
    for y in 1..rules.H - 1 { for x in 1..rules.W - 1 { require(g.tile(x, y) != 1, "no interior walls " + tag); } }
}

func start() {
    var repaired = 0; var minSeen = 999; var maxSeen = 0;
    for room in 0..10 {
        var signatures: List[Integer] = [];
        for sample in 0..48 {
            var g = new rules.Board(); g.seed = 1 + sample * 7919 + room * 101; g.lives = 5;
            rooms.load(g, room);
            var tag = "room " + Fmt.Int(room + 1) + " seed " + Fmt.Int(g.seed);
            contract(g, room, tag);
            var crates = g.crateCount();
            if crates < minSeen { minSeen = crates; } if crates > maxSeen { maxSeen = crates; }
            require(crates >= rooms.minCrates(room) / 2 && crates < rooms.minCrates(room) + rooms.CRATE_SPAN, "crate count within range " + tag);
            var sig = signature(g);
            var h = new rules.Board(); h.seed = 1 + sample * 7919 + room * 101; h.lives = 5;
            rooms.load(h, room);
            require(signature(h) == sig, "same seed reproduces the room " + tag);
            for k in 0..signatures.length() { require(signatures.get(k) != sig, "different seeds differ " + tag); }
            signatures.add(sig);
            // Room is playable through its grace period without anything moving.
            for _ in 0..rules.GRACE {
                g.tick();
                for i in 0..g.cats.length() { var c = g.cats.get(i); require(c.x == c.homeX && c.y == c.homeY, "nothing moves in grace " + tag); }
            }
            require(g.state == rules.PLAY, "start survives grace " + tag);
        }
    }
    require(minSeen >= 7 && maxSeen <= rules.MAX_CRATES, "observed crate range sane");

    // The repair path (zero attempts) still yields a valid, connected, covered room.
    for room in 0..10 {
        var g = new rules.Board(); g.seed = 4242 + room; rooms.generate(g, room, 0);
        repaired = repaired + 1;
        contract(g, room, "repaired room " + Fmt.Int(room + 1));
    }
    require(repaired == 10, "repair exercised for every room");
    // Repair on a hand-built broken board: sealed pocket, cat staring down the entrance.
    var b = new rules.Board(); b.seed = 9; b.clearRoom(); b.mx = 2; b.my = 2;
    for y in 1..rules.H - 1 { b.setTile(10, y, 2); }
    b.addCat(2, 8, 1);
    require(!b.connected() && b.exposed(2, 2), "broken fixture is broken");
    rooms.repair(b);
    require(b.connected() && !b.exposed(b.mx, b.my), "repair opens the wall and rehomes the cat");

    // Long random play: cap holds, and every drop keeps the objectives reachable. The mouse
    // walks only onto free cells so any loss of reachability could only come from a drop.
    var drops = 0; var refusals = 0; var escapes = 0;
    for sample in 0..6 {
        var g = new rules.Board(); g.seed = 77 + sample * 31; g.lives = 5; g.difficulty = 2;
        rooms.load(g, 6 + sample % 4);
        var moves = 5 + sample;
        var lastEscape = -100;
        for _ in 0..900 {
            moves = (moves * 25173 + 13849) % 65536;
            if g.state == rules.DEAD { g.resume(); require(g.state == rules.PLAY || g.state == rules.OVER, "resume result"); }
            if g.state == rules.OVER { break; }
            if g.state == rules.PLAY && moves % 2 == 0 {
                var d = (moves / 2) % 4;
                var nx = g.mx + rules.dx(d); var ny = g.my + rules.dy(d);
                if g.tile(nx, ny) == 0 { g.step(rules.dx(d), rules.dy(d)); }
            }
            var before = g.crateCount();
            g.tick();
            var after = g.crateCount();
            require(after <= rules.MAX_CRATES, "crate cap during play");
            if after > before { drops = drops + 1; }
            if g.event == 12 {
                require(g.ticks - lastEscape > 1, "escape events never spam consecutive ticks");
                lastEscape = g.ticks; escapes = escapes + 1;
            }
            if g.state == rules.PLAY {
                require(g.reachesAll(g.flood(g.mx, g.my)), "objectives reachable after every tick");
                require(g.freeNeighbors(g.mx, g.my, -1, -1) > 0, "mouse never sealed by a drop");
            }
        }
        // Fill the board to the cap and confirm further drops are refused outright.
        var x = 1; var y = 1;
        while g.crateCount() < rules.MAX_CRATES && y < rules.H - 1 {
            if g.tile(x, y) == 0 && !(x == g.mx && y == g.my) && g.catAt(x, y) < 0 && !g.reserved(x, y) { g.setTile(x, y, 2); }
            x = x + 1; if x >= rules.W - 1 { x = 1; y = y + 1; }
        }
        if g.crateCount() >= rules.MAX_CRATES {
            for ty in 1..rules.H - 1 {
                for tx in 1..rules.W - 1 {
                    if g.tile(tx, ty) == 0 && g.catAt(tx, ty) < 0 && !g.reserved(tx, ty) {
                        if !g.drop(tx, ty) { refusals = refusals + 1; }
                        require(g.tile(tx, ty) == 0, "drop refused at the cap");
                    }
                }
            }
        }
    }
    require(drops > 0, "random play produced drops");
    require(refusals > 0, "cap refusal exercised");
    Terminal.Say("DROPS: " + Fmt.Int(drops) + " ESCAPES: " + Fmt.Int(escapes));
    Terminal.Say("RESULT: ok");
}
