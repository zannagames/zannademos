// File: zannademos/catnmouse/campaign_probe.zia
// Purpose: Validate authored topology and deterministic state across seeded runs.
// Key invariants:
//   - Fixed walls do not create disconnected pickup islands in any room.
//   - VM and native execution emit the same state trace for all actions.
// Ownership/Lifetime:
//   - Each run owns a fresh board; flood queues are local to a room check.
// Links: rules.zia, rooms.zia, README.md
//===----------------------------------------------------------------------===//
module campaign_probe;
bind Zanna.Terminal as Terminal;
bind Zanna.System.Environment as Env;
bind Zanna.Text.Fmt as Fmt;
bind "./rules";
bind "./rooms";

func require(ok: Boolean, message: String) {
    if !ok { Terminal.Say("FAIL: " + message); Env.Exit(1); }
}

func connected(g: rules.Board) {
    var seen: List[Integer] = [];
    while seen.length() < rules.W * rules.H { seen.add(0); }
    var queue: List[Integer] = [g.my * rules.W + g.mx];
    seen.set(queue.get(0), 1); var head = 0;
    while head < queue.length() {
        var pos = queue.get(head); head = head + 1;
        for d in 0..4 {
            var x = pos % rules.W + rules.dx(d); var y = pos / rules.W + rules.dy(d);
            if g.tile(x, y) != 1 {
                var next = y * rules.W + x;
                if seen.get(next) == 0 { seen.set(next, 1); queue.add(next); }
            }
        }
    }
    for y in 1..rules.H - 1 {
        for x in 1..rules.W - 1 {
            require(g.tile(x, y) == 1 || seen.get(y * rules.W + x) == 1, "wall-disconnected floor");
        }
    }
}

func valid(g: rules.Board) {
    require(g.tile(g.mx, g.my) == 0 && g.catAt(g.mx, g.my) < 0, "mouse occupies floor");
    require(g.collected >= 0 && g.collected <= 12, "collection bounds");
    require(g.cheese.length() + g.collected == 12, "cheese conservation in authored rooms");
    for i in 0..g.cats.length() {
        var c = g.cats.get(i);
        if c.alive {
            require(g.tile(c.x, c.y) == 0, "cat occupies floor");
            for j in 0..i {
                var other = g.cats.get(j);
                require(!other.alive || other.x != c.x || other.y != c.y, "cats never overlap");
            }
        }
    }
    for i in 0..g.cheese.length() {
        var pos = g.cheese.get(i);
        require(g.tile(pos % rules.W, pos / rules.W) == 0, "cheese never inside a crate");
        for j in 0..i { require(g.cheese.get(j) != pos, "cheese never duplicates"); }
    }
    if g.state == rules.PLAY { require(!g.danger(g.mx, g.my), "survivor must be covered"); }
}

func start() {
    var trace = 0;
    for room in 0..10 {
        for sample in 1..9 {
            var g = new rules.Board(); g.seed = sample * 173; rooms.load(g, room);
            connected(g); valid(g);
            var count = g.liveCats(); g.capture();
            require(g.liveCats() == count, "no cat begins already captured");
            var moves = sample * 83;
            for action in 0..240 {
                moves = (moves * 25173 + 13849) % 65536;
                if g.state == rules.DEAD { g.resume(); }
                if g.state == rules.PLAY {
                    var d = moves % 5;
                    if d == 4 { g.step(0, 0); } else { g.step(rules.dx(d), rules.dy(d)); }
                }
                valid(g);
                trace = (trace * 31 + action + g.mx + g.my * rules.W + g.collected * rules.W * rules.H + g.lives * 4096 + g.state) % 2147483647;
                for i in 0..g.cheese.length() { trace = (trace * 7 + g.cheese.get(i)) % 2147483647; }
                for i in 0..g.cats.length() {
                    var c = g.cats.get(i);
                    if c.alive { trace = (trace * 7 + c.x + c.y * rules.W) % 2147483647; }
                }
            }
        }
    }
    Terminal.Say("TRACE: " + Fmt.Int(trace));
    Terminal.Say("RESULT: ok");
}
